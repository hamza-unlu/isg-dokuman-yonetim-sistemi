<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifreyi Sıfırla - İSG Doküman Yönetim Sistemi</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        .sifre-guclu-bar {
            height: 6px;
            background: #e2e8f0;
            border-radius: 3px;
            margin-top: 6px;
            overflow: hidden;
        }
        .sifre-guclu-bar-dolu {
            height: 100%;
            transition: width 0.3s, background 0.3s;
            width: 0;
            background: #ef4444;
        }
        .sifre-guclu-metin {
            font-size: 12px;
            color: #64748b;
            margin-top: 4px;
        }
        .mesaj-kutu {
            display: none;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 12px;
        }
        .mesaj-kutu.basarili { background: #dcfce7; color: #166534; border: 1px solid #86efac; display: block; }
        .mesaj-kutu.hata     { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; display: block; }
    </style>
</head>
<body>

    <div class="giris-kapsayici">

        <div class="giris-baslik">
            <h2 class="logo-yazisi">🛡️ ÜNLÜ İSG</h2>
            <h3>Yeni Şifre Belirleyin</h3>
            <p>Hesabınız için yeni bir şifre oluşturun</p>
        </div>

        <form class="giris-formu" id="sifre-sifirla-formu">

            <div id="mesaj-kutu" class="mesaj-kutu"></div>

            <div class="form-grubu">
                <label for="yeniSifre">Yeni Şifre</label>
                <input type="password" id="yeniSifre" required minlength="6" placeholder="En az 6 karakter">
                <div class="sifre-guclu-bar">
                    <div class="sifre-guclu-bar-dolu" id="sifre-bar"></div>
                </div>
                <div class="sifre-guclu-metin" id="sifre-metin">Şifre gücü: —</div>
            </div>

            <div class="form-grubu">
                <label for="yeniSifreTekrar">Yeni Şifre (Tekrar)</label>
                <input type="password" id="yeniSifreTekrar" required minlength="6" placeholder="Şifrenizi tekrar girin">
            </div>

            <button type="submit" class="giris-butonu" id="gonder-btn">ŞİFREYİ GÜNCELLE</button>

            <div class="form-alt-linkler">
                <a href="/">Giriş sayfasına dön</a>
            </div>
        </form>
    </div>

<script>
// URL'den token'ı al
const token = window.location.pathname.split('/').pop();

const form        = document.getElementById('sifre-sifirla-formu');
const mesajKutu   = document.getElementById('mesaj-kutu');
const gonderBtn   = document.getElementById('gonder-btn');
const sifreBar    = document.getElementById('sifre-bar');
const sifreMetin  = document.getElementById('sifre-metin');
const yeniSifre   = document.getElementById('yeniSifre');

// Basit şifre gücü hesaplayıcısı
yeniSifre.addEventListener('input', (e) => {
    const s = e.target.value;
    let puan = 0;
    if (s.length >= 6)              puan++;
    if (s.length >= 10)             puan++;
    if (/[A-Z]/.test(s))            puan++;
    if (/[0-9]/.test(s))            puan++;
    if (/[^A-Za-z0-9]/.test(s))     puan++;

    const yuzde = Math.min(100, (puan / 5) * 100);
    sifreBar.style.width = yuzde + '%';

    if (puan <= 2)      { sifreBar.style.background = '#ef4444'; sifreMetin.textContent = 'Şifre gücü: Zayıf'; }
    else if (puan <= 3) { sifreBar.style.background = '#f59e0b'; sifreMetin.textContent = 'Şifre gücü: Orta'; }
    else                { sifreBar.style.background = '#10b981'; sifreMetin.textContent = 'Şifre gücü: Güçlü'; }
});

form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const yeni  = yeniSifre.value;
    const tekrar = document.getElementById('yeniSifreTekrar').value;

    mesajKutu.className = 'mesaj-kutu';
    mesajKutu.style.display = 'none';

    if (yeni !== tekrar) {
        mesajKutu.textContent = 'İki şifre eşleşmiyor. Lütfen tekrar kontrol edin.';
        mesajKutu.classList.add('hata');
        mesajKutu.style.display = 'block';
        return;
    }

    if (yeni.length < 6) {
        mesajKutu.textContent = 'Şifre en az 6 karakter olmalıdır.';
        mesajKutu.classList.add('hata');
        mesajKutu.style.display = 'block';
        return;
    }

    gonderBtn.disabled = true;
    gonderBtn.textContent = 'Güncelleniyor...';

    try {
        const res  = await fetch(`/api/auth/sifre-sifirla/${token}`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ yeniSifre: yeni }),
        });
        const veri = await res.json();

        if (!res.ok) throw new Error(veri.hata || 'İşlem başarısız.');

        mesajKutu.textContent = (veri.mesaj || 'Şifreniz başarıyla güncellendi.') + ' Giriş sayfasına yönlendiriliyorsunuz...';
        mesajKutu.classList.add('basarili');
        mesajKutu.style.display = 'block';

        // Eski token varsa temizle
        localStorage.removeItem('isg_token');
        localStorage.removeItem('isg_kullanici');

        setTimeout(() => { window.location.href = '/'; }, 2500);

    } catch (hata) {
        mesajKutu.textContent = hata.message;
        mesajKutu.classList.add('hata');
        mesajKutu.style.display = 'block';
        gonderBtn.disabled = false;
        gonderBtn.textContent = 'ŞİFREYİ GÜNCELLE';
    }
});
</script>
</body>
</html>
