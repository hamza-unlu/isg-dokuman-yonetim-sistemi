<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NACE Kodu Yönetimi — Ünlü İSG</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/auth.js"></script>
    <script src="/profil.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        /* ─── SAYFA BAŞLIĞI ─── */
        .sayfa-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            gap: 16px;
        }
        .sayfa-header-sol h1 {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.3px;
            margin: 0;
        }
        .sayfa-header-sol p {
            font-size: 13px;
            color: #64748b;
            margin: 4px 0 0;
        }

        /* ─── YENİ NACE BUTONU ─── */
        .btn-yeni-nace {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #2563eb;
            color: #fff;
            border: none;
            padding: 11px 20px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: background .15s, box-shadow .15s, transform .1s;
            box-shadow: 0 2px 8px rgba(37,99,235,0.25);
            white-space: nowrap;
            flex-shrink: 0;
        }
        .btn-yeni-nace:hover {
            background: #1d4ed8;
            box-shadow: 0 4px 14px rgba(37,99,235,0.35);
            transform: translateY(-1px);
        }

        /* ─── STAT BANDI ─── */
        .stat-bant {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 14px;
            margin-bottom: 22px;
        }
        .stat-kutu {
            background: #fff;
            border: 1px solid #e8edf5;
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .stat-ikon {
            width: 42px; height: 42px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
        }
        .stat-ikon.mavi    { background: #eff6ff; color: #2563eb; }
        .stat-ikon.yesil   { background: #f0fdf4; color: #16a34a; }
        .stat-ikon.turuncu { background: #fff7ed; color: #ea580c; }
        .stat-ikon.kirmizi { background: #fef2f2; color: #dc2626; }
        .stat-metin .sayi   { font-size: 24px; font-weight: 800; color: #0f172a; line-height: 1; }
        .stat-metin .etiket { font-size: 11.5px; color: #64748b; font-weight: 500; margin-top: 3px; }

        /* ─── ARAMA ve FİLTRE ÇUBUĞU ─── */
        .filtre-cubuk {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }
        .arama-kutu {
            flex: 1;
            min-width: 260px;
            position: relative;
        }
        .arama-kutu i {
            position: absolute;
            left: 14px; top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 13px;
        }
        .arama-kutu input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 13.5px;
            font-family: inherit;
            outline: none;
            background: #fff;
            color: #0f172a;
            transition: border-color .15s;
        }
        .arama-kutu input:focus { border-color: #2563eb; }
        .filtre-select {
            padding: 11px 14px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 13.5px;
            font-family: inherit;
            outline: none;
            background: #fff;
            color: #0f172a;
            cursor: pointer;
            min-width: 180px;
            transition: border-color .15s;
        }
        .filtre-select:focus { border-color: #2563eb; }

        /* ─── TABLO KARTI ─── */
        .tablo-kart {
            background: #fff;
            border: 1px solid #e8edf5;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        }
        .tablo-kart-baslik {
            padding: 16px 22px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .baslik-ikon {
            width: 32px; height: 32px;
            background: #eff6ff;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #2563eb; font-size: 14px;
        }
        .tablo-kart-baslik h3 {
            font-size: 14.5px; font-weight: 700; color: #0f172a; margin: 0; flex: 1;
        }
        .nace-sayac-badge {
            background: #f1f5f9; color: #475569;
            font-size: 11.5px; font-weight: 600;
            padding: 3px 10px; border-radius: 20px;
        }

        /* ─── TABLO ─── */
        table { width: 100%; border-collapse: collapse; }
        thead tr { background: #f8fafc; }
        th {
            padding: 11px 16px;
            text-align: left;
            font-size: 11px; font-weight: 700;
            color: #64748b;
            text-transform: uppercase; letter-spacing: 0.6px;
            border-bottom: 1px solid #e2e8f0;
        }
        th:first-child { width: 44px; text-align: center; }
        td {
            padding: 13px 16px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 13px; vertical-align: middle; color: #334155;
        }
        td:first-child { text-align: center; color: #cbd5e1; font-size: 12px; font-weight: 600; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafbff; }

        .nace-kod {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            background: #f1f5f9;
            color: #1e293b;
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 12px;
            display: inline-block;
        }
        .nace-tanim { color: #0f172a; font-weight: 500; }

        /* ─── SINIF ETİKETLERİ ─── */
        .sinif-etiket {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 10px; border-radius: 6px;
            font-size: 11.5px; font-weight: 700;
            white-space: nowrap;
        }
        .sinif-az       { background: #dcfce7; color: #15803d; }
        .sinif-tehlike  { background: #fff7ed; color: #c2410c; }
        .sinif-cok      { background: #fee2e2; color: #dc2626; }

        /* ─── İŞLEM ─── */
        .islem-grup { display: flex; gap: 6px; align-items: center; }
        .btn-duzenle {
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            background: #eff6ff; border: 1px solid #bfdbfe;
            color: #2563eb; border-radius: 7px;
            cursor: pointer; font-size: 12px;
            transition: background .15s;
        }
        .btn-duzenle:hover { background: #dbeafe; }
        .btn-sil {
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            background: #fee2e2; border: 1px solid #fecaca;
            color: #dc2626; border-radius: 7px;
            cursor: pointer; font-size: 12px;
            transition: background .15s;
        }
        .btn-sil:hover { background: #fecaca; }

        /* ─── SAYFALAMA ─── */
        .sayfalama {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 22px;
            border-top: 1px solid #f1f5f9;
            gap: 14px;
            flex-wrap: wrap;
        }
        .sayfalama-bilgi {
            font-size: 12.5px;
            color: #64748b;
        }
        .sayfalama-butonlar {
            display: flex;
            gap: 6px;
            align-items: center;
        }
        .sayfa-btn {
            min-width: 34px; height: 34px;
            padding: 0 10px;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #334155;
            border-radius: 7px;
            font-size: 12.5px; font-weight: 600;
            cursor: pointer;
            transition: all .15s;
            font-family: inherit;
        }
        .sayfa-btn:hover:not(:disabled) {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #2563eb;
        }
        .sayfa-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
        .sayfa-btn.aktif {
            background: #2563eb;
            color: #fff;
            border-color: #2563eb;
        }

        /* ─── MODAL ─── */
        .modal-arka {
            display: none; position: fixed; inset: 0;
            background: rgba(15,23,42,0.55);
            backdrop-filter: blur(3px);
            z-index: 1000; align-items: center; justify-content: center;
        }
        .modal-arka.acik { display: flex; }
        .modal-icerik {
            background: #fff; padding: 28px; border-radius: 16px;
            width: 100%; max-width: 460px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.18);
            animation: modalGir .2s ease;
        }
        @keyframes modalGir {
            from { opacity: 0; transform: translateY(12px) scale(.98); }
            to   { opacity: 1; transform: translateY(0)   scale(1);    }
        }
        .modal-baslik {
            display: flex; align-items: center;
            justify-content: space-between; margin-bottom: 22px;
        }
        .modal-baslik-sol { display: flex; align-items: center; gap: 10px; }
        .modal-b-ikon {
            width: 36px; height: 36px; background: #eff6ff;
            border-radius: 9px; display: flex; align-items: center;
            justify-content: center; color: #2563eb; font-size: 15px;
        }
        .modal-b-yazi h4 { font-size: 15px; font-weight: 800; color: #0f172a; margin: 0; }
        .modal-b-yazi p  { font-size: 12px; color: #64748b; margin: 1px 0 0; }
        .btn-kapat {
            width: 30px; height: 30px; display: flex; align-items: center;
            justify-content: center; border-radius: 7px; background: #f1f5f9;
            color: #64748b; cursor: pointer; font-size: 13px; border: none;
            transition: background .15s;
        }
        .btn-kapat:hover { background: #e2e8f0; }

        .form-grup { margin-bottom: 14px; }
        .form-grup label {
            display: block; font-size: 12.5px; font-weight: 600;
            color: #374151; margin-bottom: 6px;
        }
        .form-grup label span { color: #dc2626; margin-left: 2px; }
        .form-grup input, .form-grup select {
            width: 100%; padding: 10px 13px;
            border: 1.5px solid #e2e8f0; border-radius: 9px;
            font-size: 13.5px; font-family: inherit; outline: none;
            color: #0f172a; background: #fafafa;
            transition: border-color .15s, background .15s;
        }
        .form-grup input:focus, .form-grup select:focus {
            border-color: #2563eb; background: #fff;
        }
        .btn-kaydet {
            width: 100%; background: #2563eb; color: #fff; border: none;
            padding: 12px; border-radius: 10px; font-size: 14px; font-weight: 700;
            font-family: inherit; cursor: pointer; margin-top: 8px;
            transition: background .15s, transform .1s;
        }
        .btn-kaydet:hover { background: #1d4ed8; transform: translateY(-1px); }

        /* ─── DURUM MESAJI ─── */
        .durum-mesaji {
            text-align: center; padding: 48px 20px;
            color: #94a3b8; font-size: 14px;
        }
        .durum-mesaji i { font-size: 28px; display: block; margin-bottom: 10px; }
    </style>
</head>
<body>
<div class="panel-kapsayici">

    <nav class="yan-menu">
        <div class="yan-menu-baslik"><h2>🛡️ ÜNLÜ İSG</h2></div>
        <ul class="menu-ogeleri">
            <li><a href="/anasayfa"><i class="fa-solid fa-home"></i> ANA SAYFA</a></li>
            <li><a href="/firmalar"><i class="fa-solid fa-building"></i> FİRMALAR</a></li>
            <li><a href="/personel"><i class="fa-solid fa-users"></i> PERSONEL</a></li>
            <li><a href="/egitimler"><i class="fa-solid fa-graduation-cap"></i> EĞİTİMLER</a></li>
            <li><a href="/dokumanlar"><i class="fa-solid fa-file-alt"></i> DOKÜMANLAR</a></li>
            <li><a href="/raporlar"><i class="fa-solid fa-chart-pie"></i> RAPORLAR</a></li>
            <li><a href="/kullanicilar"><i class="fa-solid fa-users-gear"></i> KULLANICILAR</a></li>
            <li class="menu-alt"><a href="/"><i class="fa-solid fa-sign-out-alt"></i> ÇIKIŞ</a></li>
        </ul>
    </nav>

    <main class="ana-icerik">
        <header class="ust-bar">
            <div class="hosgeldin-metni"><h3>NACE Kodu Yönetimi</h3></div>
            <div class="kullanici-profili">
                <div class="kullanici-bilgisi">
                    <span class="isim" id="header-isim">Yükleniyor...</span>
                    <span class="rol"  id="header-rol">...</span>
                </div>
                <div class="kullanici-avatar" id="header-avatar">?</div>
            </div>
        </header>

        <div class="icerik">

            <!-- BAŞLIK + YENİ NACE BUTONU -->
            <div class="sayfa-header">
                <div class="sayfa-header-sol">
                    <h1>NACE Kodları</h1>
                    <p>Sistemdeki ekonomik faaliyet (NACE) kodlarını görüntüleyin ve yönetin</p>
                </div>
                <button class="btn-yeni-nace" onclick="modalAc()">
                    <i class="fa-solid fa-plus"></i> Yeni NACE Kodu
                </button>
            </div>

            <!-- STAT BANDI -->
            <div class="stat-bant">
                <div class="stat-kutu">
                    <div class="stat-ikon mavi"><i class="fa-solid fa-list"></i></div>
                    <div class="stat-metin">
                        <div class="sayi" id="stat-toplam">—</div>
                        <div class="etiket">Toplam Kod</div>
                    </div>
                </div>
                <div class="stat-kutu">
                    <div class="stat-ikon yesil"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="stat-metin">
                        <div class="sayi" id="stat-az">—</div>
                        <div class="etiket">Az Tehlikeli</div>
                    </div>
                </div>
                <div class="stat-kutu">
                    <div class="stat-ikon turuncu"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <div class="stat-metin">
                        <div class="sayi" id="stat-tehlike">—</div>
                        <div class="etiket">Tehlikeli</div>
                    </div>
                </div>
                <div class="stat-kutu">
                    <div class="stat-ikon kirmizi"><i class="fa-solid fa-circle-exclamation"></i></div>
                    <div class="stat-metin">
                        <div class="sayi" id="stat-cok">—</div>
                        <div class="etiket">Çok Tehlikeli</div>
                    </div>
                </div>
            </div>

            <!-- ARAMA + FİLTRE -->
            <div class="filtre-cubuk">
                <div class="arama-kutu">
                    <i class="fa-solid fa-search"></i>
                    <input type="text" id="arama-input"
                           placeholder="Kod veya tanım içinde ara (örn: 01.11 veya Baklagil)">
                </div>
                <select id="sinif-filtre" class="filtre-select">
                    <option value="">Tüm Sınıflar</option>
                    <option value="Az Tehlikeli">Az Tehlikeli</option>
                    <option value="Tehlikeli">Tehlikeli</option>
                    <option value="Çok Tehlikeli">Çok Tehlikeli</option>
                </select>
            </div>

            <!-- NACE LİSTESİ -->
            <div class="tablo-kart">
                <div class="tablo-kart-baslik">
                    <div class="baslik-ikon"><i class="fa-solid fa-list-ul"></i></div>
                    <h3>NACE Kod Listesi</h3>
                    <span class="nace-sayac-badge" id="nace-sayac">0 kayıt</span>
                </div>
                <div id="tablo-konteyner">
                    <div class="durum-mesaji">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        NACE kodları yükleniyor...
                    </div>
                </div>
                <div class="sayfalama" id="sayfalama-alani" style="display:none;">
                    <div class="sayfalama-bilgi" id="sayfalama-bilgi">—</div>
                    <div class="sayfalama-butonlar" id="sayfalama-butonlar"></div>
                </div>
            </div>

        </div>
    </main>
</div>

<!-- MODAL: Ekle / Düzenle -->
<div class="modal-arka" id="nace-modal">
    <div class="modal-icerik">
        <div class="modal-baslik">
            <div class="modal-baslik-sol">
                <div class="modal-b-ikon"><i class="fa-solid fa-plus"></i></div>
                <div class="modal-b-yazi">
                    <h4 id="modal-baslik-yazi">Yeni NACE Kodu</h4>
                    <p id="modal-aciklama-yazi">Sisteme yeni bir NACE kodu ekleyin</p>
                </div>
            </div>
            <button class="btn-kapat" onclick="modalKapat()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <input type="hidden" id="duzenle-id">
        <div class="form-grup">
            <label>NACE Kodu <span>*</span></label>
            <input type="text" id="form-kod" placeholder="Örn: 01.11.07">
        </div>
        <div class="form-grup">
            <label>Tanım <span>*</span></label>
            <input type="text" id="form-tanim" placeholder="Örn: Baklagillerin yetiştirilmesi">
        </div>
        <div class="form-grup">
            <label>Tehlike Sınıfı <span>*</span></label>
            <select id="form-sinif">
                <option value="Az Tehlikeli">Az Tehlikeli</option>
                <option value="Tehlikeli">Tehlikeli</option>
                <option value="Çok Tehlikeli">Çok Tehlikeli</option>
            </select>
        </div>
        <button class="btn-kaydet" onclick="naceKaydet()">
            <i class="fa-solid fa-check" style="margin-right:7px;"></i><span id="kaydet-btn-yazi">Oluştur ve Kaydet</span>
        </button>
    </div>
</div>

<%- include('partials/profil-modal') %>
<script>
// ═══════════════════════════════════════════════════════════════════════════
// NACE YÖNETİM SAYFASI
// ═══════════════════════════════════════════════════════════════════════════

const SAYFA_BUYUKLUGU = 50;
let tumNaceKodlari = [];       // Backend'den gelen tüm kodlar (bellekte filtreleniyor)
let filtrelenmisListe = [];    // Arama+filtre sonrası gösterilecek liste
let mevcutSayfa = 1;
let aramaZamanlayici = null;   // Arama için debounce

// ─── SAYFA YÜKLENDİĞİNDE ────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
    const kullanici = AUTH.kullaniciAl();
    if (kullanici) {
        document.getElementById('header-isim').textContent   = kullanici.adSoyad || kullanici.ad || 'Kullanıcı';
        document.getElementById('header-rol').textContent    = (kullanici.rol || 'Belirsiz').replace(/_/g, ' ').toUpperCase();
        document.getElementById('header-avatar').textContent = (kullanici.adSoyad || 'İS').substring(0, 2).toUpperCase();
    }
    if (!kullanici || kullanici.rol !== 'sistem_yoneticisi') {
        alert('Bu sayfaya erişim yetkiniz yok.');
        window.location.href = '/anasayfa';
        return;
    }

    // Arama kutusu — 300ms debounce
    document.getElementById('arama-input').addEventListener('input', () => {
        clearTimeout(aramaZamanlayici);
        aramaZamanlayici = setTimeout(() => {
            mevcutSayfa = 1;
            filtreleVeGoster();
        }, 300);
    });

    // Sınıf filtresi
    document.getElementById('sinif-filtre').addEventListener('change', () => {
        mevcutSayfa = 1;
        filtreleVeGoster();
    });

    await naceKodlariniYukle();
});

// ─── VERİYİ BACKEND'DEN YÜKLE ────────────────────────────────────────────────
async function naceKodlariniYukle() {
    try {
        const res = await AUTH.apiFetch('/api/nace');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        tumNaceKodlari = data.veri || [];

        // İstatistikleri güncelle
        document.getElementById('stat-toplam').textContent  = tumNaceKodlari.length;
        document.getElementById('stat-az').textContent      = tumNaceKodlari.filter(n => n.sinif === 'Az Tehlikeli').length;
        document.getElementById('stat-tehlike').textContent = tumNaceKodlari.filter(n => n.sinif === 'Tehlikeli').length;
        document.getElementById('stat-cok').textContent     = tumNaceKodlari.filter(n => n.sinif === 'Çok Tehlikeli').length;

        filtreleVeGoster();
    } catch (e) {
        document.getElementById('tablo-konteyner').innerHTML =
            `<div class="durum-mesaji" style="color:#dc2626;">
                <i class="fa-solid fa-circle-exclamation"></i>
                Hata: ${_esc(e.message)}
             </div>`;
    }
}

// ─── ARAMA + FİLTRE UYGULA ───────────────────────────────────────────────────
function filtreleVeGoster() {
    const arama = (document.getElementById('arama-input').value || '').toLowerCase().trim();
    const sinif = document.getElementById('sinif-filtre').value;

    filtrelenmisListe = tumNaceKodlari.filter(n => {
        if (sinif && n.sinif !== sinif) return false;
        if (arama) {
            const k = (n.kod   || '').toLowerCase();
            const t = (n.tanim || '').toLowerCase();
            if (!k.includes(arama) && !t.includes(arama)) return false;
        }
        return true;
    });

    document.getElementById('nace-sayac').textContent = `${filtrelenmisListe.length} kayıt`;
    sayfayiGoster();
}

// ─── SAYFA GÖSTER ────────────────────────────────────────────────────────────
function sayfayiGoster() {
    const toplam = filtrelenmisListe.length;
    const toplamSayfa = Math.max(1, Math.ceil(toplam / SAYFA_BUYUKLUGU));
    if (mevcutSayfa > toplamSayfa) mevcutSayfa = toplamSayfa;

    if (toplam === 0) {
        document.getElementById('tablo-konteyner').innerHTML = `
            <div class="durum-mesaji">
                <i class="fa-solid fa-folder-open"></i>
                Arama kriterlerinize uyan kayıt bulunamadı.
            </div>`;
        document.getElementById('sayfalama-alani').style.display = 'none';
        return;
    }

    const baslangic = (mevcutSayfa - 1) * SAYFA_BUYUKLUGU;
    const bitis     = Math.min(baslangic + SAYFA_BUYUKLUGU, toplam);
    const parca     = filtrelenmisListe.slice(baslangic, bitis);

    const SINIF_CLASS = {
        'Az Tehlikeli':  'sinif-az',
        'Tehlikeli':     'sinif-tehlike',
        'Çok Tehlikeli': 'sinif-cok',
    };
    const SINIF_IKON = {
        'Az Tehlikeli':  'fa-shield-halved',
        'Tehlikeli':     'fa-triangle-exclamation',
        'Çok Tehlikeli': 'fa-circle-exclamation',
    };

    const satirlar = parca.map((n, i) => {
        const sinifClass = SINIF_CLASS[n.sinif] || 'sinif-az';
        const sinifIkon  = SINIF_IKON[n.sinif]  || 'fa-shield-halved';
        return `
        <tr>
            <td>${baslangic + i + 1}</td>
            <td><span class="nace-kod">${_esc(n.kod)}</span></td>
            <td><div class="nace-tanim">${_esc(n.tanim)}</div></td>
            <td>
                <span class="sinif-etiket ${sinifClass}">
                    <i class="fa-solid ${sinifIkon}"></i> ${_esc(n.sinif)}
                </span>
            </td>
            <td>
                <div class="islem-grup">
                    <button class="btn-duzenle" onclick="modalDuzenle('${n._id}')" title="Düzenle">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button class="btn-sil" onclick="naceSil('${n._id}', '${_esc(n.kod)}')" title="Sil">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            </td>
        </tr>`;
    }).join('');

    document.getElementById('tablo-konteyner').innerHTML = `
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>NACE Kodu</th>
                    <th>Tanım</th>
                    <th>Tehlike Sınıfı</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>${satirlar}</tbody>
        </table>`;

    sayfalamayiGoster(toplam, toplamSayfa, baslangic + 1, bitis);
}

// ─── SAYFALAMA BUTONLARI ─────────────────────────────────────────────────────
function sayfalamayiGoster(toplam, toplamSayfa, ilk, son) {
    document.getElementById('sayfalama-alani').style.display = 'flex';
    document.getElementById('sayfalama-bilgi').textContent =
        `${ilk}-${son} arası gösteriliyor / Toplam ${toplam} kayıt`;

    const butonlar = document.getElementById('sayfalama-butonlar');
    let html = '';

    // İlk sayfa + geri
    html += `<button class="sayfa-btn" onclick="sayfaDegistir(1)" ${mevcutSayfa === 1 ? 'disabled' : ''} title="İlk sayfa">
                <i class="fa-solid fa-angles-left"></i>
             </button>`;
    html += `<button class="sayfa-btn" onclick="sayfaDegistir(${mevcutSayfa - 1})" ${mevcutSayfa === 1 ? 'disabled' : ''} title="Önceki">
                <i class="fa-solid fa-angle-left"></i>
             </button>`;

    // Sayfa numaraları (akıllı aralık: mevcut ± 2, uçlarda ... ile)
    const aralik = sayfalamaAraligi(mevcutSayfa, toplamSayfa);
    aralik.forEach(p => {
        if (p === '...') {
            html += `<span style="padding:0 6px;color:#94a3b8;">…</span>`;
        } else {
            html += `<button class="sayfa-btn ${p === mevcutSayfa ? 'aktif' : ''}" onclick="sayfaDegistir(${p})">${p}</button>`;
        }
    });

    // İleri + son sayfa
    html += `<button class="sayfa-btn" onclick="sayfaDegistir(${mevcutSayfa + 1})" ${mevcutSayfa === toplamSayfa ? 'disabled' : ''} title="Sonraki">
                <i class="fa-solid fa-angle-right"></i>
             </button>`;
    html += `<button class="sayfa-btn" onclick="sayfaDegistir(${toplamSayfa})" ${mevcutSayfa === toplamSayfa ? 'disabled' : ''} title="Son sayfa">
                <i class="fa-solid fa-angles-right"></i>
             </button>`;

    butonlar.innerHTML = html;
}

function sayfalamaAraligi(mevcut, toplam) {
    // Akıllı aralık: başta, sonda ve mevcut civarında göster
    const sonuc = [];
    const pencere = 2;
    const baslar = new Set();

    baslar.add(1);
    baslar.add(toplam);
    for (let i = mevcut - pencere; i <= mevcut + pencere; i++) {
        if (i >= 1 && i <= toplam) baslar.add(i);
    }

    const sirali = [...baslar].sort((a, b) => a - b);
    let oncekiSayi = 0;
    sirali.forEach(s => {
        if (oncekiSayi && s - oncekiSayi > 1) sonuc.push('...');
        sonuc.push(s);
        oncekiSayi = s;
    });
    return sonuc;
}

function sayfaDegistir(yeniSayfa) {
    mevcutSayfa = yeniSayfa;
    sayfayiGoster();
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ─── MODAL: Ekle / Düzenle ───────────────────────────────────────────────────
function modalAc() {
    document.getElementById('duzenle-id').value = '';
    document.getElementById('form-kod').value = '';
    document.getElementById('form-tanim').value = '';
    document.getElementById('form-sinif').value = 'Az Tehlikeli';
    document.getElementById('modal-baslik-yazi').textContent    = 'Yeni NACE Kodu';
    document.getElementById('modal-aciklama-yazi').textContent = 'Sisteme yeni bir NACE kodu ekleyin';
    document.getElementById('kaydet-btn-yazi').textContent     = 'Oluştur ve Kaydet';
    document.getElementById('nace-modal').classList.add('acik');
    document.getElementById('form-kod').focus();
}

function modalDuzenle(id) {
    const nace = tumNaceKodlari.find(n => n._id === id);
    if (!nace) return;
    document.getElementById('duzenle-id').value = id;
    document.getElementById('form-kod').value   = nace.kod;
    document.getElementById('form-tanim').value = nace.tanim;
    document.getElementById('form-sinif').value = nace.sinif;
    document.getElementById('modal-baslik-yazi').textContent    = 'NACE Kodunu Düzenle';
    document.getElementById('modal-aciklama-yazi').textContent = 'Seçili kodun bilgilerini güncelleyin';
    document.getElementById('kaydet-btn-yazi').textContent     = 'Değişiklikleri Kaydet';
    document.getElementById('nace-modal').classList.add('acik');
}

function modalKapat() {
    document.getElementById('nace-modal').classList.remove('acik');
}

document.getElementById('nace-modal').addEventListener('click', function(e) {
    if (e.target === this) modalKapat();
});

// ─── KAYDET (hem ekle hem güncelle) ──────────────────────────────────────────
async function naceKaydet() {
    const id    = document.getElementById('duzenle-id').value;
    const kod   = document.getElementById('form-kod').value.trim();
    const tanim = document.getElementById('form-tanim').value.trim();
    const sinif = document.getElementById('form-sinif').value;

    if (!kod || !tanim || !sinif) {
        alert('Lütfen tüm alanları doldurun.');
        return;
    }

    try {
        const yol    = id ? `/api/nace/${id}` : '/api/nace';
        const method = id ? 'PUT' : 'POST';
        const res = await AUTH.apiFetch(yol, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ kod, tanim, sinif }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.hata || 'Bilinmeyen hata');

        alert(id ? '✅ NACE kodu güncellendi!' : '✅ NACE kodu eklendi!');
        modalKapat();
        await naceKodlariniYukle();
    } catch (err) {
        alert('❌ Hata: ' + err.message);
    }
}

// ─── SİL ─────────────────────────────────────────────────────────────────────
async function naceSil(id, kod) {
    if (!confirm(`"${kod}" kodlu NACE kaydını silmek istediğinize emin misiniz?`)) return;
    try {
        const res = await AUTH.apiFetch(`/api/nace/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.hata || 'Bilinmeyen hata');
        await naceKodlariniYukle();
    } catch (e) {
        alert('❌ Hata: ' + e.message);
    }
}

// ─── YARDIMCI ────────────────────────────────────────────────────────────────
function _esc(str) {
    return (str || '').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
</script>
