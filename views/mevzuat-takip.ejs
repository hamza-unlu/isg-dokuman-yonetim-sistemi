let mevcutKurallar = [];
let mevcutKuralSayisi = 0;

async function bekleyenlerToggle() {
    const bolum = document.getElementById('bekleyenler-bolum');
    const kart = document.getElementById('stat-bekleyen-kart');
    const acik = bolum.classList.toggle('acik');
    kart.classList.toggle('aktif', acik);

    if (acik) {
        await bekleyenleriYukle();
