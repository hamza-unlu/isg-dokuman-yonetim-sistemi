<%- include('partials/profil-modal') %>
<script>
// ═══════════════════════════════════════════════════════════════════════════
// MEVZUAT OTOMATİK TAKİP — Frontend
// ═══════════════════════════════════════════════════════════════════════════

let tumMevzuatlar = [];
let scheduler = null;

// ─── SAYFA YÜKLENDİĞİNDE ────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
    const kullanici = AUTH.kullaniciAl();
    if (kullanici) {
        document.getElementById('header-isim').textContent = kullanici.adSoyad || 'Kullanıcı';
        document.getElementById('header-rol').textContent = (kullanici.rol || '').replace(/_/g, ' ').toUpperCase();

        const avatarEl = document.getElementById('header-avatar');
        const fotoUrl = kullanici.profilFotoUrl || kullanici.fotoUrl || kullanici.profilFoto;
        if (fotoUrl) {
            avatarEl.innerHTML = `<img src="${fotoUrl}" alt="${kullanici.adSoyad || ''}" style="width:100%; height:100%; object-fit:cover; border-radius:50%;">`;
        } else {
            const adSoyad = kullanici.adSoyad || 'İS';
            const harfler = adSoyad
                .split(' ')
                .filter(p => p.length > 0)
                .map(p => p[0].toUpperCase())
                .slice(0, 2)
                .join('');
            avatarEl.textContent = harfler;
        }
    }
    await verileriYukle();

    document.getElementById('arama-input').addEventListener('input', tabloyuYenidenCiz);
    document.getElementById('durum-filtre').addEventListener('change', tabloyuYenidenCiz);
    document.getElementById('kategori-filtre').addEventListener('change', tabloyuYenidenCiz);

    document.getElementById('form-modal').addEventListener('click', function(e) {
        if (e.target === this) formModalKapat();
    });
    document.getElementById('gecmis-modal').addEventListener('click', function(e) {
        if (e.target === this) gecmisKapat();
    });

    setInterval(durumYenile, 30000);
});

// ─── VERİLERİ YÜKLE ─────────────────────────────────────────────────────────
async function verileriYukle() {
    try {
        const [durumRes, listeRes] = await Promise.all([
            AUTH.apiFetch('/api/mevzuat-takip/durum'),
            AUTH.apiFetch('/api/mevzuat-takip/liste'),
        ]);

        const durumData = await durumRes.json();
        const listeData = await listeRes.json();

        if (durumData.basarili) {
            scheduler = durumData.scheduler;
            statKartlariCiz(durumData.ozet);
            schedulerKartiCiz(durumData.scheduler);
        }

        if (listeData.basarili) {
            tumMevzuatlar = listeData.veri;
            tabloyuYenidenCiz();
        }
    } catch (err) {
        toastGoster('Veriler yüklenemedi: ' + err.message, true);
    }
}

async function durumYenile() {
    try {
        const res = await AUTH.apiFetch('/api/mevzuat-takip/durum');
        const data = await res.json();
        if (data.basarili) {
            statKartlariCiz(data.ozet);
            schedulerKartiCiz(data.scheduler);
        }
    } catch {}
}

function statKartlariCiz(ozet) {
    document.getElementById('stat-toplam').textContent = ozet.takipEdilenMevzuat || 0;
    document.getElementById('stat-aktif').textContent = ozet.aktifSayi || 0;
    document.getElementById('stat-hatali').textContent = ozet.hataliSayi || 0;
    document.getElementById('stat-bekleyen').textContent = ozet.onayBekleyenDegisiklik || 0;
}

function schedulerKartiCiz(sch) {
    const rozet = document.getElementById('scheduler-rozet');
    const detay = document.getElementById('scheduler-detay');

    rozet.textContent = sch.aktif ? 'AKTİF' : 'PASİF';
    rozet.className = 'durum-rozeti ' + (sch.aktif ? 'durum-aktif' : 'durum-pasif');

    let metin = sch.cronAciklama + ' • ' + sch.zamanDilimi;
    if (sch.sonCalismaTarihi) {
        const tarih = new Date(sch.sonCalismaTarihi);
        metin += ' • Son tarama: ' + tarih.toLocaleString('tr-TR');
    }
    detay.textContent = metin;
}

function tabloyuYenidenCiz() {
    const arama = document.getElementById('arama-input').value.toLowerCase().trim();
    const durumFiltre = document.getElementById('durum-filtre').value;
    const kategoriFiltre = document.getElementById('kategori-filtre').value;

    let filtreli = tumMevzuatlar.filter(m => {
        const adUyuyor = !arama || m.ad.toLowerCase().includes(arama);
        const durumUyuyor = !durumFiltre ||
            (durumFiltre === 'pasif' ? !m.aktif : m.takipDurumu === durumFiltre);
        const kategoriUyuyor = !kategoriFiltre || m.kategori === kategoriFiltre;
        return adUyuyor && durumUyuyor && kategoriUyuyor;
    });

    const tbody = document.getElementById('tablo-govde');

    if (filtreli.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="durum-mesaji"><i class="fa-solid fa-inbox"></i>Kriterlere uygun mevzuat bulunamadı</td></tr>';
        return;
    }

    tbody.innerHTML = filtreli.map(m => {
        const durumClass = {
            'aktif': 'durum-aktif-et',
            'url-hatasi': 'durum-hatali-et',
            'hazır': 'durum-hazir-et',
            'pasif': 'durum-pasif-et',
            'erisilemez': 'durum-erisilemez-et',
        }[m.takipDurumu] || 'durum-pasif-et';

        const durumYazi = {
            'aktif': '✅ Aktif',
            'url-hatasi': '⚠️ URL Hatalı',
            'hazır': '🆕 Hazır',
            'pasif': '⏸️ Pasif',
            'erisilemez': '🔌 Erişilemez',
        }[m.takipDurumu] || m.takipDurumu;

        const sonTarama = m.sonTaramaTarihi
            ? new Date(m.sonTaramaTarihi).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' })
            : '—';

        const basariOrani = m.toplamTaramaSayisi > 0
            ? Math.round((m.basariliTaramaSayisi / m.toplamTaramaSayisi) * 100)
            : null;
        const basariYazi = basariOrani !== null
            ? `${basariOrani}% <small style="color:#94a3b8;">(${m.basariliTaramaSayisi}/${m.toplamTaramaSayisi})</small>`
            : '<small style="color:#cbd5e1;">Henüz taranmadı</small>';

        const hataMesaji = m.sonHataMesaji
            ? `<div class="hata-bant"><i class="fa-solid fa-circle-exclamation"></i> ${_esc(m.sonHataMesaji)}</div>`
            : '';

        return `
            <tr>
                <td>
                    <div class="mevzuat-adi">${_esc(m.ad)}</div>
                    ${m.aciklama ? `<div class="mevzuat-aciklama">${_esc(m.aciklama)}</div>` : ''}
                    ${hataMesaji}
                </td>
                <td><span class="kategori-etiket">${_esc(m.kategori)}</span></td>
                <td><span class="durum-etiket ${durumClass}">${durumYazi}</span></td>
                <td style="font-size:12px; color:#64748b;">${sonTarama}</td>
                <td style="font-size:12px;">${basariYazi}</td>
                <td>
                    <div class="islem-grup" style="justify-content:flex-end;">
                        <button class="btn-ikon btn-duzenle" title="Düzenle" onclick='duzenleModalAc(${JSON.stringify(m)})'>
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-ikon btn-tekrar" title="Tekrar Tara" onclick="tekrarDene('${m._id}')">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                        <button class="btn-ikon btn-gecmis" title="Versiyon Geçmişi" onclick="gecmisAc('${m.anahtar}', '${_esc(m.ad).replace(/'/g, "\\'")}')">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </button>
                        <button class="btn-ikon btn-sil" title="Sil" onclick="mevzuatSil('${m._id}', '${_esc(m.ad).replace(/'/g, "\\'")}')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

// ═══════════════════════════════════════════════════════════════════════════
// ⭐ URL ANALİZ HELPER (Yeni)
// ═══════════════════════════════════════════════════════════════════════════
// Yapıştırılan mevzuat.gov.tr URL'ini parse eder, payload alanlarını üretir.
//
// Desteklenen formatlar:
//   1. https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=17031&MevzuatTur=7&MevzuatTertip=5
//   2. https://www.mevzuat.gov.tr/MevzuatMetin/7.5.45087.pdf
//   3. https://www.mevzuat.gov.tr/File/GeneratePdf?mevzuatNo=17031&mevzuatTur=KurumVeKurulusYonetmeligi&mevzuatTertip=5
//   4. https://mevzuat.gov.tr/anasayfa/MevzuatFihristDetayIframe?MevzuatTur=7&MevzuatNo=18371&MevzuatTertip=5

function urlAnaliz(url) {
    if (!url || !url.trim()) return null;
    url = url.trim();

    const sonuc = {
        pdfURL: '',
        htmlURL: '',
        mevzuatNo: '',
        tertip: '5',
        anahtar: '',
        gecerli: true, // ⭐ artık her zaman true — engelleme yok
        mevzuatSitesi: false,
    };

    try {
        const mevzuatSitesi = url.toLowerCase().includes('mevzuat.gov.tr');
        sonuc.mevzuatSitesi = mevzuatSitesi;

        const pdfBelirtileri = ['.pdf', 'GeneratePdf', '/MevzuatMetin/'];
        const pdfMu = pdfBelirtileri.some(b => url.toLowerCase().includes(b.toLowerCase()));

        if (pdfMu) {
            sonuc.pdfURL = url;
        } else {
            sonuc.htmlURL = url;
        }

        try {
            const u = new URL(url);
            const params = {};
            for (const [key, value] of u.searchParams.entries()) {
                params[key.toLowerCase()] = value;
            }
            if (params['mevzuatno']) sonuc.mevzuatNo = params['mevzuatno'];
            if (params['mevzuattertip']) sonuc.tertip = params['mevzuattertip'];
        } catch {}

        if (!sonuc.mevzuatNo) {
            const m = url.match(/(\d+)\.(\d+)\.(\d+)\.pdf/);
            if (m) {
                sonuc.mevzuatNo = m[3];
                sonuc.tertip = m[2];
            }
        }

        if (sonuc.mevzuatNo) {
            sonuc.anahtar = `mevzuat_${sonuc.mevzuatNo}`;
        }

        return sonuc;
    } catch (err) {
        console.warn('URL parse hatası:', err);
        return sonuc;
    }
}

function linkDegisti() {
    const link = document.getElementById('form-link').value.trim();
    const bilgiEl = document.getElementById('link-bilgi');
    const bilgiYazi = document.getElementById('link-bilgi-yazi');

    if (!link) {
        bilgiEl.classList.remove('acik', 'basarili', 'uyari', 'hata');
        return;
    }

    const sonuc = urlAnaliz(link);
    if (!sonuc) return;

    // ⭐ Her durumda hidden alanları doldur
    document.getElementById('form-pdfurl').value = sonuc.pdfURL;
    document.getElementById('form-htmlurl').value = sonuc.htmlURL;
    document.getElementById('form-mevzuatno').value = sonuc.mevzuatNo;
    if (sonuc.anahtar) {
        document.getElementById('form-anahtar').value = sonuc.anahtar;
    }

    // Gelişmiş paneli güncelle
    document.getElementById('bilgi-anahtar').textContent = sonuc.anahtar || '—';
    document.getElementById('bilgi-pdfurl').textContent = sonuc.pdfURL || '—';
    document.getElementById('bilgi-htmlurl').textContent = sonuc.htmlURL || '—';
    document.getElementById('bilgi-mevzuatno').textContent = sonuc.mevzuatNo || '—';
    document.getElementById('bilgi-tertip').textContent = sonuc.tertip || '5';

    // mevzuat.gov.tr değilse sarı uyarı göster ama kaydetmeyi engelleme
    if (!sonuc.mevzuatSitesi) {
        bilgiEl.classList.remove('basarili', 'hata');
        bilgiEl.classList.add('acik', 'uyari');
        bilgiYazi.innerHTML = `
            <i class="fa-solid fa-triangle-exclamation"></i>
            Bu mevzuat.gov.tr linki gibi görünmüyor. Lütfen kontrol edin.
        `;
    } else {
        bilgiEl.classList.remove('uyari', 'hata');
        bilgiEl.classList.add('acik', 'basarili');
        const detay = sonuc.pdfURL ? '📄 PDF linki' : '🌐 HTML sayfa linki';
        bilgiYazi.innerHTML = `
            <i class="fa-solid fa-check-circle"></i>
            <strong>Link tanındı.</strong> ${detay}
            ${sonuc.mevzuatNo ? ` • Mevzuat No: ${sonuc.mevzuatNo}` : ''}.
            <strong>"URL Test Et"</strong> ile doğrulayın.
        `;
    }
}

function gelismisToggle() {
    document.getElementById('gelismis-accordion').classList.toggle('acik');
}

// ═══════════════════════════════════════════════════════════════════════════
// 📡 ŞİMDİ TARA + BİLDİRİM KUTUSU
// ═══════════════════════════════════════════════════════════════════════════

let taramaInterval = null;
let taramaBaslangic = null;

async function simdiTara() {
    const btn = document.getElementById('btn-tara');
    if (btn) {
        btn.disabled = true;
        btn.classList.add('tarama-devam');
    }

    taramaBildirimBaslat();

    try {
        const res = await AUTH.apiFetch('/api/mevzuat-takip/tara', { method: 'POST' });
        const data = await res.json();

        if (!data.basarili) {
            taramaBildirimHata(data.hata || 'Tarama başlatılamadı');
            if (btn) { btn.disabled = false; btn.classList.remove('tarama-devam'); }
            return;
        }

        taramaPollingBaslat();

    } catch (err) {
        taramaBildirimHata('Bağlantı hatası: ' + err.message);
        if (btn) { btn.disabled = false; btn.classList.remove('tarama-devam'); }
    }
}

function taramaBildirimBaslat() {
    taramaBaslangic = Date.now();
    const bildirim = document.getElementById('tarama-bildirim');

    bildirim.classList.remove('tamamlandi', 'hata');
    bildirim.classList.add('devam-ediyor');

    document.getElementById('tarama-bildirim-baslik-yazi').textContent = 'Tarama devam ediyor...';
    document.getElementById('tarama-bildirim-altYazi').textContent = 'Mevzuat kontrol ediliyor';
    document.getElementById('tarama-bildirim-ikon').innerHTML = '<i class="fa-solid fa-satellite-dish"></i>';
    document.getElementById('tarama-gecen-sure').textContent = '0';
    document.getElementById('tarama-yuzde').textContent = '0%';
    document.getElementById('tarama-progress-dolum').style.width = '0%';

    document.getElementById('tarama-ilerleme-alani').style.display = 'block';
    document.getElementById('tarama-ozet-alani').style.display = 'none';

    setTimeout(() => bildirim.classList.add('gorunur'), 50);
}

function taramaPollingBaslat() {
    let aramaSayisi = 0;
    const maxArama = 90;

    taramaInterval = setInterval(async () => {
        aramaSayisi++;
        if (aramaSayisi > maxArama) {
            clearInterval(taramaInterval);
            taramaBildirimHata('Tarama çok uzun sürdü, zaman aşımı');
            return;
        }

        const gecenSn = Math.floor((Date.now() - taramaBaslangic) / 1000);
        document.getElementById('tarama-gecen-sure').textContent = gecenSn;

        const tahminiYuzde = Math.min(Math.floor((gecenSn / 35) * 100), 95);
        document.getElementById('tarama-yuzde').textContent = tahminiYuzde + '%';
        document.getElementById('tarama-progress-dolum').style.width = tahminiYuzde + '%';

        try {
            const res = await AUTH.apiFetch('/api/mevzuat-takip/durum');
            const data = await res.json();

            if (data.basarili && !data.ozet.islemDevamEdiyor) {
                clearInterval(taramaInterval);
                taramaBildirimTamamla(gecenSn);
            }
        } catch (err) {}
    }, 2000);
}

async function taramaBildirimTamamla(gecenSn) {
    const btn = document.getElementById('btn-tara');
    if (btn) {
        btn.disabled = false;
        btn.classList.remove('tarama-devam');
    }

    const bildirim = document.getElementById('tarama-bildirim');
    bildirim.classList.remove('devam-ediyor');
    bildirim.classList.add('tamamlandi');

    document.getElementById('tarama-progress-dolum').style.width = '100%';
    document.getElementById('tarama-yuzde').textContent = '100%';

    document.getElementById('tarama-bildirim-baslik-yazi').textContent = '✅ Tarama tamamlandı!';
    document.getElementById('tarama-bildirim-altYazi').textContent = `${gecenSn} saniyede bitti`;
    document.getElementById('tarama-bildirim-ikon').innerHTML = '<i class="fa-solid fa-circle-check"></i>';

    setTimeout(async () => {
        try {
            const res = await AUTH.apiFetch('/api/mevzuat-takip/durum');
            const data = await res.json();
            const ozet = data.ozet || {};

            document.getElementById('ozet-yeni').textContent = ozet.yeniSayi || 0;
            document.getElementById('ozet-degisti').textContent = ozet.onayBekleyenDegisiklik || 0;
            document.getElementById('ozet-degismemis').textContent = ozet.aktifSayi || 0;
            document.getElementById('ozet-mukerrer').textContent = '—';
            document.getElementById('ozet-hata').textContent = ozet.hataliSayi || 0;

            const degistiSayi = ozet.onayBekleyenDegisiklik || 0;
            const incelBtn = document.getElementById('btn-sonuc-incele');
            if (degistiSayi > 0) {
                incelBtn.style.display = 'inline-flex';
                incelBtn.innerHTML = `<i class="fa-solid fa-arrow-right"></i> ${degistiSayi} Onay Bekleyen`;
            } else {
                incelBtn.style.display = 'none';
            }
        } catch (err) {
            console.warn('Özet alınamadı:', err);
        }

        document.getElementById('tarama-ilerleme-alani').style.display = 'none';
        document.getElementById('tarama-ozet-alani').style.display = 'block';

        if (typeof verileriYukle === 'function') {
            await verileriYukle();
        }
    }, 800);
}

function taramaBildirimHata(mesaj) {
    if (taramaInterval) clearInterval(taramaInterval);

    const bildirim = document.getElementById('tarama-bildirim');
    bildirim.classList.remove('devam-ediyor', 'tamamlandi');
    bildirim.classList.add('hata');

    document.getElementById('tarama-bildirim-baslik-yazi').textContent = '❌ Tarama hatası';
    document.getElementById('tarama-bildirim-altYazi').textContent = mesaj;
    document.getElementById('tarama-bildirim-ikon').innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';

    setTimeout(taramaBildirimKapat, 6000);
}

function taramaBildirimKapat() {
    if (taramaInterval) {
        clearInterval(taramaInterval);
        taramaInterval = null;
    }
    document.getElementById('tarama-bildirim').classList.remove('gorunur');
}

function taramaSonucIncele() {
    taramaBildirimKapat();
    if (typeof bekleyenlerToggle === 'function') {
        const bolum = document.getElementById('bekleyenler-bolum');
        if (bolum && !bolum.classList.contains('acik')) {
            bekleyenlerToggle();
        }
        setTimeout(() => {
            const hedef = document.getElementById('bekleyenler-bolum');
            if (hedef) hedef.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 200);
    }
}

async function tekrarDene(id) {
    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/tekrar-dene/${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.basarili) {
            toastGoster('Tarama başarılı');
        } else {
            toastGoster('Hata: ' + (data.sonuc?.hata || data.hata || 'Bilinmeyen'), true);
        }
        await verileriYukle();
    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

async function mevzuatSil(id, ad) {
    if (!confirm(`"${ad}" mevzuatını takip listesinden çıkarmak istediğinize emin misiniz?\n\n(Versiyon geçmişi korunacak)`)) return;

    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/sil/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.basarili) {
            toastGoster('Mevzuat silindi');
            await verileriYukle();
        } else {
            toastGoster(data.hata || 'Silme başarısız', true);
        }
    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

