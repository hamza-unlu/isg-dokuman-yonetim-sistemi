<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mevzuat Otomatik Takip — Ünlü İSG</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/auth.js"></script>
    <script src="/profil.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        /* ─── SAYFA BAŞLIĞI ─── */
        .sayfa-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 24px; gap: 16px; flex-wrap: wrap;
        }
        .sayfa-header-sol h1 {
            font-size: 20px; font-weight: 800; color: #0f172a;
            letter-spacing: -0.3px; margin: 0;
        }
        .sayfa-header-sol p {
            font-size: 13px; color: #64748b; margin: 4px 0 0;
        }
        .btn-header {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 11px 18px; border-radius: 10px;
            font-size: 13.5px; font-weight: 600; cursor: pointer;
            font-family: inherit; transition: all .15s;
            border: none; white-space: nowrap;
        }
        .btn-tara {
            background: #16a34a; color: #fff;
            box-shadow: 0 2px 8px rgba(22,163,74,0.25);
        }
        .btn-tara:hover { background: #15803d; transform: translateY(-1px); }
        .btn-tara:disabled { background: #94a3b8; cursor: not-allowed; transform: none; }
        .btn-yeni {
            background: #2563eb; color: #fff;
            box-shadow: 0 2px 8px rgba(37,99,235,0.25);
        }
        .btn-yeni:hover { background: #1d4ed8; transform: translateY(-1px); }

        /* ─── STAT BANDI ─── */
        .stat-bant {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px; margin-bottom: 22px;
        }
        .stat-kutu {
            background: #fff; border: 1px solid #e8edf5;
            border-radius: 12px; padding: 16px 20px;
            display: flex; align-items: center; gap: 14px;
        }
        .stat-ikon {
            width: 44px; height: 44px; border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 17px; flex-shrink: 0;
        }
        .stat-ikon.toplam   { background: #dbeafe; color: #1d4ed8; }
        .stat-ikon.aktif    { background: #dcfce7; color: #15803d; }
        .stat-ikon.hatali   { background: #fee2e2; color: #b91c1c; }
        .stat-ikon.bekleyen { background: #fef3c7; color: #b45309; }
        .stat-metin .sayi   { font-size: 22px; font-weight: 800; color: #0f172a; line-height: 1; }
        .stat-metin .etiket {
            font-size: 11px; color: #64748b; font-weight: 500;
            margin-top: 4px; text-transform: uppercase; letter-spacing: 0.4px;
        }

        /* ─── SCHEDULER KARTI ─── */
        .scheduler-kart {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border: 1px solid #bae6fd;
            border-radius: 14px; padding: 18px 22px; margin-bottom: 22px;
            display: flex; align-items: center; justify-content: space-between;
            gap: 16px; flex-wrap: wrap;
        }
        .scheduler-bilgi {
            display: flex; align-items: center; gap: 14px; flex: 1;
        }
        .scheduler-ikon {
            width: 48px; height: 48px; background: #0284c7; color: #fff;
            border-radius: 12px; display: flex; align-items: center; justify-content: center;
            font-size: 20px; flex-shrink: 0;
        }
        .scheduler-yazi h3 { margin: 0; font-size: 15px; color: #0c4a6e; }
        .scheduler-yazi p { margin: 4px 0 0; font-size: 12.5px; color: #075985; }
        .scheduler-yazi .durum-rozeti {
            display: inline-block; padding: 2px 8px; border-radius: 5px;
            font-size: 11px; font-weight: 700; margin-left: 6px;
        }
        .durum-aktif { background: #16a34a; color: #fff; }
        .durum-pasif { background: #94a3b8; color: #fff; }

        /* ─── FİLTRELER ─── */
        .filtre-bant {
            display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap;
        }
        .filtre-bant input, .filtre-bant select {
            padding: 9px 12px; border: 1.5px solid #e2e8f0; border-radius: 9px;
            font-size: 13px; font-family: inherit; outline: none;
            background: #fff;
        }
        .filtre-bant input { flex: 1; min-width: 200px; }
        .filtre-bant input:focus, .filtre-bant select:focus { border-color: #2563eb; }

        /* ─── TABLO ─── */
        .tablo-kart {
            background: #fff; border: 1px solid #e8edf5;
            border-radius: 14px; overflow: hidden;
            box-shadow: 0 1px 6px rgba(0,0,0,0.04);
            margin-bottom: 20px;
        }
        table { width: 100%; border-collapse: collapse; }
        thead tr { background: #f8fafc; }
        th {
            padding: 12px 16px; text-align: left;
            font-size: 11px; font-weight: 700; color: #64748b;
            text-transform: uppercase; letter-spacing: 0.6px;
            border-bottom: 1px solid #e2e8f0;
        }
        td {
            padding: 13px 16px; border-bottom: 1px solid #f1f5f9;
            font-size: 13px; vertical-align: middle; color: #334155;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafbff; }

        .mevzuat-adi { font-weight: 600; color: #0f172a; }
        .mevzuat-aciklama { font-size: 11.5px; color: #64748b; margin-top: 2px; }

        /* ─── DURUM ETİKETLERİ ─── */
        .durum-etiket {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 10px; border-radius: 5px;
            font-size: 11px; font-weight: 700; white-space: nowrap;
        }
        .durum-aktif-et    { background: #dcfce7; color: #15803d; }
        .durum-hatali-et   { background: #fee2e2; color: #b91c1c; }
        .durum-hazir-et    { background: #fef3c7; color: #b45309; }
        .durum-pasif-et    { background: #f1f5f9; color: #475569; }
        .durum-erisilemez-et { background: #fed7aa; color: #c2410c; }

        .kategori-etiket {
            display: inline-block; padding: 3px 9px;
            background: #ede9fe; color: #6d28d9;
            border-radius: 5px; font-size: 11px; font-weight: 600;
        }

        /* ─── İŞLEM BUTONLARI ─── */
        .islem-grup { display: flex; gap: 5px; }
        .btn-ikon {
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 7px; cursor: pointer;
            font-size: 12px; font-weight: 600;
            transition: all .15s; border: 1.5px solid;
        }
        .btn-duzenle {
            background: #2563eb; border-color: #2563eb; color: #fff;
        }
        .btn-duzenle:hover { background: #1d4ed8; transform: translateY(-1px); }
        .btn-tekrar {
            background: #f59e0b; border-color: #f59e0b; color: #fff;
        }
        .btn-tekrar:hover { background: #d97706; transform: translateY(-1px); }
        .btn-gecmis {
            background: #7c3aed; border-color: #7c3aed; color: #fff;
        }
        .btn-gecmis:hover { background: #6d28d9; transform: translateY(-1px); }
        .btn-sil {
            background: #ef4444; border-color: #ef4444; color: #fff;
        }
        .btn-sil:hover { background: #dc2626; transform: translateY(-1px); }

        /* ─── MODAL ─── */
        .modal-arka {
            display: none; position: fixed; inset: 0;
            background: rgba(15,23,42,0.55); backdrop-filter: blur(3px);
            z-index: 1000; align-items: center; justify-content: center;
            padding: 20px;
        }
        .modal-arka.acik { display: flex; }
        .modal-icerik {
            background: #fff; padding: 28px; border-radius: 16px;
            width: 100%; max-width: 580px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.18);
            animation: modalGir .2s ease;
            max-height: 90vh; overflow-y: auto;
        }
        .modal-icerik.genis { max-width: 760px; }
        @keyframes modalGir {
            from { opacity: 0; transform: translateY(12px) scale(.98); }
            to   { opacity: 1; transform: translateY(0)   scale(1);    }
        }
        .modal-baslik {
            display: flex; align-items: center;
            justify-content: space-between; margin-bottom: 22px;
        }
        .modal-baslik-sol { display: flex; align-items: center; gap: 10px; }
        .modal-b-ikon {
            width: 40px; height: 40px; background: #eff6ff;
            border-radius: 10px; display: flex; align-items: center;
            justify-content: center; color: #2563eb; font-size: 16px;
        }
        .modal-b-yazi h4 { font-size: 16px; font-weight: 800; color: #0f172a; margin: 0; }
        .modal-b-yazi p { font-size: 12px; color: #64748b; margin: 1px 0 0; }
        .btn-kapat {
            width: 32px; height: 32px; display: flex;
            align-items: center; justify-content: center;
            border-radius: 8px; background: #f1f5f9;
            color: #64748b; cursor: pointer; font-size: 14px; border: none;
            transition: background .15s;
        }
        .btn-kapat:hover { background: #e2e8f0; }

        /* ─── FORM ─── */
        .form-grup { margin-bottom: 14px; }
        .form-grup label {
            display: block; font-size: 12.5px; font-weight: 600;
            color: #374151; margin-bottom: 6px;
        }
        .form-grup label .gerekli { color: #dc2626; margin-left: 2px; }
        .form-grup label small {
            color: #94a3b8; font-weight: 400; font-size: 11px; margin-left: 6px;
        }
        .form-grup input, .form-grup select, .form-grup textarea {
            width: 100%; padding: 10px 13px;
            border: 1.5px solid #e2e8f0; border-radius: 9px;
            font-size: 13.5px; font-family: inherit; outline: none;
            color: #0f172a; background: #fafafa;
            transition: border-color .15s, background .15s;
        }
        .form-grup textarea { resize: vertical; min-height: 60px; }
        .form-grup input:focus, .form-grup select:focus, .form-grup textarea:focus {
            border-color: #2563eb; background: #fff;
        }
        .form-grup input[readonly] {
            background: #f1f5f9; color: #64748b; cursor: not-allowed;
        }

        .bilgi-kutu {
            background: #eff6ff; border: 1px solid #bfdbfe;
            border-radius: 10px; padding: 10px 14px;
            font-size: 12.5px; color: #1e40af;
            margin-bottom: 16px;
            display: flex; gap: 8px; align-items: flex-start;
        }
        .bilgi-kutu i { margin-top: 2px; flex-shrink: 0; }

        .test-sonuc {
            margin-top: 8px; padding: 8px 12px; border-radius: 8px;
            font-size: 12px; display: none;
        }
        .test-sonuc.basarili {
            display: block; background: #dcfce7; color: #15803d;
            border: 1px solid #86efac;
        }
        .test-sonuc.basarisiz {
            display: block; background: #fee2e2; color: #991b1b;
            border: 1px solid #fca5a5;
        }

        .modal-butonlar {
            display: flex; gap: 10px; margin-top: 16px;
        }
        .btn-form {
            padding: 11px 18px; border-radius: 10px; border: none;
            font-size: 14px; font-weight: 700; cursor: pointer;
            font-family: inherit; transition: all .15s;
            flex: 1;
        }
        .btn-test {
            background: #f59e0b; color: #fff;
        }
        .btn-test:hover { background: #d97706; }
        .btn-kaydet {
            background: #16a34a; color: #fff;
        }
        .btn-kaydet:hover { background: #15803d; }

        /* ─── ⭐ LINK BİLGİ KUTUSU (YENİ) ─── */
        .link-bilgi {
            display: none; margin-top: 8px; padding: 10px 12px;
            border-radius: 8px; font-size: 12.5px;
            border: 1px solid;
            display: flex; gap: 8px; align-items: flex-start;
        }
        .link-bilgi.acik { display: flex; }
        .link-bilgi.basarili {
            background: #dcfce7; border-color: #86efac; color: #15803d;
        }
        .link-bilgi.uyari {
            background: #fef3c7; border-color: #fcd34d; color: #78350f;
        }
        .link-bilgi.hata {
            background: #fee2e2; border-color: #fca5a5; color: #991b1b;
        }
        .link-bilgi i { margin-top: 2px; flex-shrink: 0; }

        /* ─── ⭐ GELİŞMİŞ AYARLAR ACCORDION (YENİ) ─── */
        .gelismis-accordion {
            margin-top: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
            background: #fafafa;
        }
        .gelismis-baslik {
            width: 100%;
            background: transparent;
            color: #475569;
            padding: 11px 14px;
            border: none;
            text-align: left;
            cursor: pointer;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.15s;
        }
        .gelismis-baslik:hover { background: #f1f5f9; }
        .gelismis-baslik .accordion-ok {
            transition: transform 0.2s;
            font-size: 11px;
        }
        .gelismis-accordion.acik .accordion-ok {
            transform: rotate(180deg);
        }
        .gelismis-icerik {
            display: none;
            padding: 14px;
            border-top: 1px solid #e2e8f0;
            background: #fff;
        }
        .gelismis-accordion.acik .gelismis-icerik {
            display: block;
        }
        .bilgi-rapor {
            background: #f8fafc; border: 1px solid #e2e8f0;
            border-radius: 8px; padding: 10px 12px;
            font-size: 11.5px; font-family: 'Consolas', monospace;
            color: #475569; line-height: 1.7;
        }
        .bilgi-rapor strong { color: #0f172a; }
        .bilgi-rapor .alan-deger {
            color: #0f172a; word-break: break-all;
        }

        /* ─── DURUM MESAJI ─── */
        .durum-mesaji {
            text-align: center; padding: 48px 20px;
            color: #94a3b8; font-size: 14px;
        }
        .durum-mesaji i { font-size: 28px; display: block; margin-bottom: 10px; }

        /* ─── HATA MESAJI BANT ─── */
        .hata-bant {
            background: #fee2e2; border: 1px solid #fecaca;
            border-radius: 8px; padding: 8px 12px;
            font-size: 12px; color: #991b1b;
            margin-top: 4px;
        }

        /* ─── BAŞARI BİLDİRİMİ (toast) ─── */
        .toast {
            position: fixed; top: 24px; right: 24px; z-index: 2000;
            background: #16a34a; color: #fff;
            padding: 14px 20px; border-radius: 10px;
            font-size: 14px; font-weight: 600;
            box-shadow: 0 8px 24px rgba(22,163,74,0.35);
            animation: toastIn .3s ease;
            display: none;
        }
        .toast.hata { background: #dc2626; }
        .toast.gor { display: block; }
        @keyframes toastIn {
            from { opacity: 0; transform: translateY(-12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ─── ONAY BEKLEYEN STAT KARTI TIKLANABİLİR ─── */
        .stat-kutu.tiklanabilir {
            cursor: pointer; transition: all .15s;
            border: 2px solid transparent;
        }
        .stat-kutu.tiklanabilir:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.08);
            border-color: #fbbf24;
        }
        .stat-kutu.tiklanabilir.aktif {
            border-color: #f59e0b;
            box-shadow: 0 4px 12px rgba(245,158,11,0.2);
        }

        /* ─── ONAY BEKLEYENLER BÖLÜMÜ ─── */
        .bekleyenler-bolum {
            background: #fffbeb; border: 1.5px solid #fcd34d;
            border-radius: 14px; padding: 18px 22px; margin-bottom: 22px;
            display: none;
        }
        .bekleyenler-bolum.acik { display: block; }
        .bekleyenler-baslik {
            font-size: 15px; font-weight: 700; color: #78350f;
            margin-bottom: 14px; display: flex; align-items: center; gap: 8px;
        }
        .bekleyen-kart {
            background: #fff; border: 1px solid #fcd34d;
            border-radius: 10px; padding: 14px 16px; margin-bottom: 10px;
            display: flex; align-items: center; justify-content: space-between;
            gap: 12px; flex-wrap: wrap;
        }
        .bekleyen-kart-sol { flex: 1; min-width: 250px; }
        .bekleyen-kart .ad {
            font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 4px;
        }
        .bekleyen-kart .meta {
            font-size: 11.5px; color: #64748b;
        }
        .btn-incele {
            background: #f59e0b; color: #fff; border: none;
            padding: 9px 16px; border-radius: 8px; font-weight: 600;
            font-size: 13px; cursor: pointer; font-family: inherit;
            display: inline-flex; align-items: center; gap: 6px;
            transition: all .15s;
        }
        .btn-incele:hover { background: #d97706; transform: translateY(-1px); }

        /* ─── ONAY MODAL — KURAL SATIRLARI ─── */
        .kural-satir {
            background: #f8fafc; border: 1px solid #e2e8f0;
            border-radius: 10px; padding: 12px 14px; margin-bottom: 10px;
        }
        .kural-satir-baslik {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 10px;
        }
        .kural-satir-no {
            font-size: 11px; font-weight: 700; color: #475569;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .btn-kural-sil {
            width: 26px; height: 26px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 6px; background: #fee2e2; color: #b91c1c;
            border: none; cursor: pointer; font-size: 11px;
            transition: all .15s;
        }
        .btn-kural-sil:hover { background: #fecaca; }
        .kural-bilgi-eski {
            background: #eff6ff; border: 1px solid #bfdbfe;
            border-radius: 6px; padding: 6px 10px; margin-bottom: 8px;
            font-size: 12px; color: #1e40af;
        }
        .yeni-deger-row {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
        }
        .btn-kural-ekle {
            background: #dbeafe; color: #1d4ed8; border: 1.5px dashed #93c5fd;
            padding: 10px 14px; border-radius: 8px; cursor: pointer;
            font-size: 13px; font-weight: 600; font-family: inherit;
            display: flex; align-items: center; justify-content: center; gap: 6px;
            width: 100%; margin-bottom: 12px;
            transition: all .15s;
        }
        .btn-kural-ekle:hover { background: #bfdbfe; }

        /* ─── ONAY BUTONLARI ─── */
        .onay-butonlar {
            display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;
            margin-top: 14px;
        }
        .btn-reddet-onay {
            background: #fee2e2; color: #991b1b; border: 1.5px solid #fca5a5;
        }
        .btn-reddet-onay:hover { background: #fecaca; }
        .btn-sadece-onayla {
            background: #f1f5f9; color: #475569; border: 1.5px solid #cbd5e1;
        }
        .btn-sadece-onayla:hover { background: #e2e8f0; }
        .btn-onayla-uygula {
            background: #16a34a; color: #fff; border: 1.5px solid #16a34a;
        }
        .btn-onayla-uygula:hover { background: #15803d; }

        /* ─── İÇERİK FARKLILIKLARI (DİFF) ─── */
        .diff-bolum {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 0;
            margin: 14px 0;
            overflow: hidden;
        }
        .diff-baslik {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 16px;
            background: #1e293b;
            color: #f1f5f9;
            cursor: pointer;
            user-select: none;
            transition: background 0.2s;
        }
        .diff-baslik:hover { background: #334155; }
        .diff-baslik-sol {
            display: flex; align-items: center; gap: 10px;
            font-weight: 600; font-size: 13.5px;
        }
        .diff-baslik-ok {
            transition: transform 0.2s;
            font-size: 11px;
        }
        .diff-bolum.acik .diff-baslik-ok {
            transform: rotate(180deg);
        }

        /* İstatistik rozetleri */
        .diff-istatistik {
            display: flex; gap: 8px; align-items: center;
            font-size: 12px;
        }
        .diff-rozet {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 3px 9px; border-radius: 6px;
            font-weight: 600; font-size: 11.5px;
        }
        .diff-rozet.eklenen { background: #16a34a; color: #fff; }
        .diff-rozet.silinen { background: #dc2626; color: #fff; }
        .diff-rozet.aynı    { background: #475569; color: #fff; }

        /* İçerik alanı */
        .diff-icerik {
            display: none;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .diff-bolum.acik .diff-icerik {
            display: block;
            max-height: 600px;
            overflow-y: auto;
        }
        .diff-icerik-inner {
            padding: 14px 16px;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 12.5px;
            line-height: 1.7;
            white-space: pre-wrap;
            word-break: break-word;
        }

        /* Her diff parçası */
        .diff-parca {
            padding: 4px 10px;
            border-radius: 4px;
            margin-bottom: 2px;
            position: relative;
        }
        .diff-parca.esit {
            color: #475569;
        }
        .diff-parca.eklendi {
            background: #dcfce7;
            color: #166534;
            border-left: 3px solid #16a34a;
        }
        .diff-parca.eklendi::before {
            content: '+';
            display: inline-block;
            width: 16px;
            font-weight: 700;
            color: #16a34a;
        }
        .diff-parca.silindi {
            background: #fee2e2;
            color: #991b1b;
            border-left: 3px solid #dc2626;
            text-decoration: line-through;
            text-decoration-color: #dc2626;
        }
        .diff-parca.silindi::before {
            content: '-';
            display: inline-block;
            width: 16px;
            font-weight: 700;
            color: #dc2626;
            text-decoration: none;
        }

        /* Diff yüklenirken */
        .diff-yukleniyor {
            padding: 30px; text-align: center;
            color: #64748b; font-size: 13px;
        }

        /* Hiç fark yok mesajı */
        .diff-bos {
            padding: 40px 20px; text-align: center;
            color: #64748b;
        }
        .diff-bos i {
            font-size: 32px; color: #cbd5e1; margin-bottom: 10px; display: block;
        }
    
        /* ─── TARAMA BİLDİRİM KUTUSU ─── */
        .tarama-bildirim {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 360px;
            background: #a3f772;
            border-radius: 14px;
            box-shadow: 0 10px 40px rgba(15, 23, 42, 0.2), 0 2px 8px rgba(15, 23, 42, 0.08);
            border: 1px solid #e2e8f0;
            z-index: 9999;
            transform: translateX(420px);
            opacity: 0;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;
            font-family: inherit;
        }
        .tarama-bildirim.gorunur {
            transform: translateX(0);
            opacity: 1;
        }
        .tarama-bildirim-baslik {
            padding: 14px 18px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #f1f5f9;
        }
        .tarama-bildirim-baslik-sol {
            display: flex; align-items: center; gap: 10px;
        }
        .tarama-bildirim-ikon {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px;
        }
        .tarama-bildirim.devam-ediyor .tarama-bildirim-ikon {
            background: #dbeafe; color: #1d4ed8;
        }
        .tarama-bildirim.tamamlandi .tarama-bildirim-ikon {
            background: #dcfce7; color: #16a34a;
        }
        .tarama-bildirim.hata .tarama-bildirim-ikon {
            background: #fee2e2; color: #dc2626;
        }
        .tarama-bildirim-baslik h4 {
            margin: 0; font-size: 14px; font-weight: 700; color: #0f172a;
        }
        .tarama-bildirim-baslik-alt {
            font-size: 11.5px; color: #64748b; margin-top: 1px;
        }
        .tarama-bildirim-kapat {
            background: transparent; border: none; cursor: pointer;
            width: 28px; height: 28px; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            color: #64748b; font-size: 14px;
            transition: all 0.15s;
        }
        .tarama-bildirim-kapat:hover {
            background: #f1f5f9; color: #0f172a;
        }
        .tarama-bildirim-icerik {
            padding: 14px 18px;
        }

        /* İlerleme satırı */
        .tarama-ilerleme-info {
            display: flex; justify-content: space-between; align-items: center;
            font-size: 12px; color: #475569; margin-bottom: 8px;
        }
        .tarama-ilerleme-info strong { color: #0f172a; font-size: 13px; }
        .tarama-progress-bar {
            width: 100%; height: 6px; background: #f1f5f9;
            border-radius: 3px; overflow: hidden;
        }
        .tarama-progress-dolum {
            height: 100%; background: linear-gradient(90deg, #3b82f6, #2563eb);
            border-radius: 3px;
            transition: width 0.5s ease;
            position: relative;
        }
        .tarama-progress-dolum::after {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: kayan-isik 1.5s linear infinite;
        }
        @keyframes kayan-isik {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        .tarama-bildirim.tamamlandi .tarama-progress-dolum {
            background: #16a34a;
        }
        .tarama-bildirim.tamamlandi .tarama-progress-dolum::after {
            display: none;
        }

        /* Sonuç istatistikleri */
        .tarama-ozet-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
            margin-bottom: 12px;
        }
        .tarama-ozet-item {
            background: #f8fafc; border: 1px solid #e2e8f0;
            border-radius: 8px; padding: 8px 10px;
            display: flex; align-items: center; gap: 8px;
        }
        .tarama-ozet-item.degisti {
            background: #fef3c7; border-color: #fcd34d;
        }
        .tarama-ozet-item.hata {
            background: #fee2e2; border-color: #fca5a5;
        }
        .tarama-ozet-ikon {
            font-size: 14px;
        }
        .tarama-ozet-yazi {
            display: flex; flex-direction: column;
        }
        .tarama-ozet-deger {
            font-size: 14px; font-weight: 700; color: #0f172a; line-height: 1;
        }
        .tarama-ozet-etiket {
            font-size: 10.5px; color: #64748b; margin-top: 2px;
        }

        /* Aksiyon butonları */
        .tarama-bildirim-butonlar {
            display: flex; gap: 6px; margin-top: 6px;
        }
        .tarama-bildirim-btn {
            flex: 1;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 12.5px; font-weight: 600;
            cursor: pointer; border: none;
            font-family: inherit;
            transition: all 0.15s;
        }
        .tarama-bildirim-btn.primer {
            background: #2563eb; color: #fff;
        }
        .tarama-bildirim-btn.primer:hover { background: #1d4ed8; }
        .tarama-bildirim-btn.ikincil {
            background: #f1f5f9; color: #475569;
        }
        .tarama-bildirim-btn.ikincil:hover { background: #e2e8f0; }

        /* Şimdi Tara butonu — devam ederken görsel feedback */
        .btn-tara:disabled {
            opacity: 0.65; cursor: not-allowed;
        }
        .btn-tara.tarama-devam .fa-rotate {
            animation: doner 1.5s linear infinite;
        }
        @keyframes doner {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
