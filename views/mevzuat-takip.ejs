}

async function bekleyenleriYukle() {
    const listeEl = document.getElementById('bekleyenler-listesi');
    listeEl.innerHTML = '<div class="durum-mesaji"><i class="fa-solid fa-spinner fa-spin"></i>Yükleniyor...</div>';

    try {
        const res = await AUTH.apiFetch('/api/mevzuat-takip/bekleyenler');
        const data = await res.json();

        document.getElementById('bekleyenler-sayi').textContent = data.sayi || 0;

        if (!data.basarili || data.sayi === 0) {
            listeEl.innerHTML = '<div class="durum-mesaji"><i class="fa-solid fa-inbox"></i>Şu an onay bekleyen değişiklik yok</div>';
            return;
        }

        listeEl.innerHTML = data.veri.map(b => {
            const tarih = new Date(b.olusturmaTarihi).toLocaleString('tr-TR');
            const boyut = (b.boyutByte / 1024).toFixed(1);
            const oncekiBilgi = b.onceki
                ? `Önceki: ${new Date(b.onceki.olusturmaTarihi).toLocaleDateString('tr-TR')} (${(b.onceki.boyutByte/1024).toFixed(1)} KB)`
                : 'İlk versiyon';

            return `
                <div class="bekleyen-kart">
                    <div class="bekleyen-kart-sol">
                        <div class="ad">${_esc(b.ad)}</div>
                        <div class="meta">
                            🆕 Yeni: ${tarih} (${boyut} KB) • ${_esc(oncekiBilgi)}
                        </div>
                    </div>
                    <button class="btn-incele" onclick="onayModalAc('${b._id}')">
                        <i class="fa-solid fa-clipboard-check"></i> İncele & Onayla
                    </button>
                </div>
            `;
        }).join('');
    } catch (err) {
        listeEl.innerHTML = `<div class="durum-mesaji" style="color:#dc2626;">Hata: ${_esc(err.message)}</div>`;
    }
}

async function onayModalAc(versiyonId) {
    document.getElementById('onay-versiyon-id').value = versiyonId;
    document.getElementById('kural-satirlari').innerHTML = '<div class="durum-mesaji"><i class="fa-solid fa-spinner fa-spin"></i>Yükleniyor...</div>';
    document.getElementById('pdf-karsilastirma').innerHTML = '';
    document.getElementById('onay-genel-not').value = '';
    document.getElementById('onay-modal').classList.add('acik');
    mevcutKuralSayisi = 0;

    diffYuklenmis = false;
    document.getElementById('diff-bolum').classList.remove('acik');
    document.getElementById('diff-istatistik').innerHTML = '<span style="opacity:0.6; font-size:11px;">tıklayın</span>';

    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/bekleyen-detay/${versiyonId}`);
        const data = await res.json();

        if (!data.basarili) {
            toastGoster(data.hata || 'Detay alınamadı', true);
            onayModalKapat();
            return;
        }

        document.getElementById('onay-modal-baslik').textContent =
            data.versiyon.ad || 'Değişikliği İncele';
        document.getElementById('onay-modal-aciklama').textContent =
            data.takipliMevzuat?.aciklama || 'Mevzuat değişikliğini detaylı incele';

        const yeniTarih = new Date(data.versiyon.olusturmaTarihi).toLocaleString('tr-TR');
        const yeniBoyut = (data.versiyon.boyutByte / 1024).toFixed(1);
        let pdfHtml = `
            <a href="/api/mevzuat-takip/pdf/${data.versiyon._id}" target="_blank"
               style="flex:1; min-width:200px; padding:10px 14px; background:#fef3c7; color:#b45309;
                      border:1px solid #fcd34d; border-radius:8px; text-decoration:none;
                      font-size:12.5px; display:flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-file-pdf"></i>
                <div>
                    <div style="font-weight:700;">🆕 Yeni Versiyon</div>
                    <div style="font-size:11px; opacity:0.85;">${yeniTarih} • ${yeniBoyut} KB</div>
                </div>
            </a>
        `;
        if (data.onceki) {
            const eskiTarih = new Date(data.onceki.olusturmaTarihi).toLocaleString('tr-TR');
            const eskiBoyut = (data.onceki.boyutByte / 1024).toFixed(1);
            pdfHtml += `
                <a href="/api/mevzuat-takip/pdf/${data.onceki._id}" target="_blank"
                   style="flex:1; min-width:200px; padding:10px 14px; background:#dbeafe; color:#1e40af;
                          border:1px solid #93c5fd; border-radius:8px; text-decoration:none;
                          font-size:12.5px; display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-file-pdf"></i>
                    <div>
                        <div style="font-weight:700;">📜 Önceki Versiyon</div>
                        <div style="font-size:11px; opacity:0.85;">${eskiTarih} • ${eskiBoyut} KB</div>
                    </div>
                </a>
            `;
        }
        document.getElementById('pdf-karsilastirma').innerHTML = pdfHtml;

        mevcutKurallar = data.kurallar || [];

        document.getElementById('kural-satirlari').innerHTML = '';
        kuralSatiriEkle();

    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

function onayModalKapat() {
    document.getElementById('onay-modal').classList.remove('acik');
}

function kuralSatiriEkle() {
    mevcutKuralSayisi++;
    const no = mevcutKuralSayisi;

    let optionsHtml = '<option value="">— Kural seçin —</option>';
    const gruplar = {};
    mevcutKurallar.forEach(k => {
        if (!gruplar[k.grup]) gruplar[k.grup] = [];
        gruplar[k.grup].push(k);
    });
    Object.keys(gruplar).sort().forEach(grup => {
        optionsHtml += `<optgroup label="${_esc(grup)}">`;
        gruplar[grup].forEach(k => {
            optionsHtml += `<option value="${k._id}" data-deger="${k.deger}" data-birim="${k.birim}">${_esc(k.kuralAdi)} — ${_esc(k.tehlikeSinifi)} (${k.deger} ${k.birim})</option>`;
        });
        optionsHtml += '</optgroup>';
    });

    const satirHtml = `
        <div class="kural-satir" id="kural-satir-${no}">
            <div class="kural-satir-baslik">
                <div class="kural-satir-no">Kural #${no}</div>
                <button class="btn-kural-sil" onclick="kuralSatiriSil(${no})" title="Kaldır">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="form-grup" style="margin-bottom:8px;">
                <label style="font-size:11.5px;">Etkilenen Kural</label>
                <select id="kural-secim-${no}" onchange="kuralSecildi(${no})">
                    ${optionsHtml}
                </select>
            </div>

            <div id="kural-eski-${no}" class="kural-bilgi-eski" style="display:none;">
                <strong>Mevcut değer:</strong> <span id="kural-eski-yazi-${no}">—</span>
            </div>

            <div class="yeni-deger-row">
                <div class="form-grup" style="margin-bottom:0;">
                    <label style="font-size:11.5px;">Yeni Değer</label>
                    <input type="number" id="kural-yeni-deger-${no}" min="0" placeholder="örn: 3">
                </div>
                <div class="form-grup" style="margin-bottom:0;">
                    <label style="font-size:11.5px;">Yeni Birim</label>
                    <select id="kural-yeni-birim-${no}">
                        <option value="yıl">yıl</option>
                        <option value="ay">ay</option>
                        <option value="saat">saat</option>
                        <option value="oran">oran</option>
                    </select>
                </div>
            </div>

            <div class="form-grup" style="margin-bottom:0; margin-top:8px;">
                <label style="font-size:11.5px;">Değişiklik Sebebi <small>(opsiyonel)</small></label>
                <input type="text" id="kural-sebep-${no}" placeholder="örn: MADDE 13 değişti, R.G. tarihi vs.">
            </div>
        </div>
    `;
    document.getElementById('kural-satirlari').insertAdjacentHTML('beforeend', satirHtml);
}

function kuralSatiriSil(no) {
    document.getElementById(`kural-satir-${no}`).remove();
}

function kuralSecildi(no) {
    const select = document.getElementById(`kural-secim-${no}`);
    const opt = select.selectedOptions[0];
    const eskiDeger = opt.getAttribute('data-deger');
    const eskiBirim = opt.getAttribute('data-birim');

    if (eskiDeger && eskiBirim) {
        document.getElementById(`kural-eski-${no}`).style.display = 'block';
        document.getElementById(`kural-eski-yazi-${no}`).textContent = `${eskiDeger} ${eskiBirim}`;
        document.getElementById(`kural-yeni-birim-${no}`).value = eskiBirim;
    } else {
        document.getElementById(`kural-eski-${no}`).style.display = 'none';
    }
}

async function onaylaVeUygula() {
    const versiyonId = document.getElementById('onay-versiyon-id').value;
    const genelNot = document.getElementById('onay-genel-not').value.trim();

    const etkilenenKurallar = [];
    const satirlar = document.querySelectorAll('[id^="kural-satir-"]');
    for (const satir of satirlar) {
        const no = satir.id.replace('kural-satir-', '');
        const mevzuatId = document.getElementById(`kural-secim-${no}`).value;
        const yeniDeger = document.getElementById(`kural-yeni-deger-${no}`).value;
        const yeniBirim = document.getElementById(`kural-yeni-birim-${no}`).value;
        const sebep = document.getElementById(`kural-sebep-${no}`).value.trim();

        if (mevzuatId && yeniDeger !== '') {
            etkilenenKurallar.push({
                mevzuatId,
                yeniDeger: Number(yeniDeger),
                yeniBirim,
                degisiklikSebebi: sebep,
            });
        }
    }

    if (etkilenenKurallar.length === 0) {
        if (!confirm('Hiçbir kural seçmediniz. Bu sadece PDF onayı olarak kaydedilecek.\n\nDevam etmek istiyor musunuz?')) {
            return;
        }
    }

    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/onayla-ve-uygula/${versiyonId}`, {
            method: 'POST',
            body: JSON.stringify({ etkilenenKurallar, genelNot }),
        });
        const data = await res.json();

        if (data.basarili) {
            toastGoster(data.mesaj || 'Onaylandı ve kurallar güncellendi');
            onayModalKapat();
            await verileriYukle();
            await bekleyenleriYukle();
        } else {
            toastGoster(data.hata || 'İşlem başarısız', true);
        }
    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

async function sadeceOnayla() {
    const versiyonId = document.getElementById('onay-versiyon-id').value;
    if (!confirm('PDF değişikliği onaylanacak ama Mevzuat kuralları güncellenmeyecek.\n\nDevam etmek istiyor musunuz?')) {
        return;
    }

    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/onayla/${versiyonId}`, { method: 'POST' });
        const data = await res.json();

        if (data.basarili) {
            toastGoster('PDF onaylandı (kural güncellemesi yapılmadı)');
            onayModalKapat();
            await verileriYukle();
            await bekleyenleriYukle();
        } else {
            toastGoster(data.hata || 'Onaylanamadı', true);
        }
    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

async function degisikligiReddet() {
    const versiyonId = document.getElementById('onay-versiyon-id').value;
    if (!confirm('Bu PDF değişikliğini reddediyorsunuz. Bir sonraki taramada tekrar tespit edilebilir.\n\nDevam etmek istiyor musunuz?')) {
        return;
    }

    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/reddet/${versiyonId}`, { method: 'POST' });
        const data = await res.json();

        if (data.basarili) {
            toastGoster('Değişiklik reddedildi');
            onayModalKapat();
            await verileriYukle();
            await bekleyenleriYukle();
        } else {
            toastGoster(data.hata || 'Reddedilemedi', true);
        }
    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

// ⚙️ CRON AYAR MODALI
function ayarModalAc() {
    if (scheduler && scheduler.cronIfadesi) {
        const select = document.getElementById('ayar-siklik');
        let bulundu = false;
        for (const opt of select.options) {
            if (opt.value === scheduler.cronIfadesi) {
                opt.selected = true;
                bulundu = true;
                break;
            }
        }
        if (!bulundu) {
            select.value = '0 3 * * 0';
        }
    }

    onizlemeyiGuncelle();
    document.getElementById('ayar-modal').classList.add('acik');
}

function ayarModalKapat() {
    document.getElementById('ayar-modal').classList.remove('acik');
}

function onizlemeyiGuncelle() {
    const select = document.getElementById('ayar-siklik');
    const opt = select.selectedOptions[0];
    const yazi = opt.getAttribute('data-yazi') || opt.textContent;
    document.getElementById('ayar-onizleme-yazi').textContent = yazi;
}

async function ayarKaydet() {
    const select = document.getElementById('ayar-siklik');
    const opt = select.selectedOptions[0];

    const payload = {
        tip: 'sablon',
        cronIfadesi: select.value,
        okunabilir: opt.getAttribute('data-yazi'),
    };

    try {
        const res = await AUTH.apiFetch('/api/mevzuat-takip/ayar/cron', {
            method: 'POST',
            body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (data.basarili) {
            toastGoster('✅ Tarama sıklığı güncellendi: ' + data.aktifAyar.cronAciklama);
            ayarModalKapat();
            await verileriYukle();
        } else {
            toastGoster(data.hata || 'Ayar kaydedilemedi', true);
        }
    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// 🔍 İÇERİK FARKLILIKLARI / DIFF
// ═══════════════════════════════════════════════════════════════════════════

let diffYuklenmis = false;

async function diffToggle() {
    const bolum = document.getElementById('diff-bolum');
    if (!bolum) {
        console.error('❌ diff-bolum elementi bulunamadı!');
        return;
    }
    const acik = bolum.classList.toggle('acik');

    if (acik && !diffYuklenmis) {
        await diffYukle();
    }
}

async function diffYukle() {
    const versiyonId = document.getElementById('onay-versiyon-id').value;
    const innerEl = document.getElementById('diff-icerik-inner');
    const istatistikEl = document.getElementById('diff-istatistik');

    if (!versiyonId) {
        console.error('❌ versiyonId boş');
        return;
    }

    innerEl.innerHTML = '<div class="diff-yukleniyor"><i class="fa-solid fa-spinner fa-spin"></i> Yükleniyor...</div>';

    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/fark/${versiyonId}`);
        const data = await res.json();

        if (!data.basarili) {
            innerEl.innerHTML = `<div class="diff-bos"><i class="fa-solid fa-exclamation-circle"></i><div>${_esc(data.hata || 'Fark hesaplanamadı')}</div></div>`;
            return;
        }

        if (data.mesaj) {
            innerEl.innerHTML = `
                <div class="diff-bos">
                    <i class="fa-solid fa-circle-info"></i>
                    <div style="font-weight:600; margin-bottom:6px;">${_esc(data.mesaj)}</div>
                    <div style="font-size:12px; color:#94a3b8;">
                        Bu durum, eski versiyonların text içeriği özelliği eklenmeden önce indirilmiş olmasından kaynaklanır. Bir sonraki taramada otomatik düzelir.
                    </div>
                </div>`;
            return;
        }

        const ist = data.istatistik;
        istatistikEl.innerHTML = `
            <span class="diff-rozet eklenen">+${ist.eklenen} eklenen</span>
            <span class="diff-rozet silinen">−${ist.silinen} silinen</span>
            <span class="diff-rozet aynı">${ist.degismeyen} aynı</span>
        `;

        if (data.farklar.length === 0 || (ist.eklenen === 0 && ist.silinen === 0)) {
            innerEl.innerHTML = `
                <div class="diff-bos">
                    <i class="fa-solid fa-circle-check" style="color:#16a34a;"></i>
                    <div style="font-weight:600;">İçerik birebir aynı</div>
                    <div style="font-size:12px;">PDF metadata değişti ama metin içeriği aynı kaldı.</div>
                </div>`;
            return;
        }

        const html = data.farklar.map(f => {
            const sinif = `diff-parca ${f.tip}`;
            const metin = _esc(f.metin);
            return `<div class="${sinif}">${metin}</div>`;
        }).join('');

        innerEl.innerHTML = html;
        diffYuklenmis = true;

    } catch (err) {
        console.error('💥 Diff hatası:', err);
        innerEl.innerHTML = `<div class="diff-bos" style="color:#dc2626;"><i class="fa-solid fa-triangle-exclamation"></i><div>Hata: ${_esc(err.message)}</div></div>`;
    }
}

// ─── TOAST ─────────────────────────────────────────────────────────────────
function toastGoster(mesaj, hata = false) {
    const t = document.getElementById('toast');
    t.textContent = mesaj;
    t.className = 'toast gor' + (hata ? ' hata' : '');
    setTimeout(() => { t.className = 'toast'; }, 3500);
}

// ─── XSS guard ─────────────────────────────────────────────────────────────
function _esc(str) {
    return (str || '').toString()
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
