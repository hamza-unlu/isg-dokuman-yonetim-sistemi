// ─── URL TEST ET ────────────────────────────────────────────────────────────
async function urlTestEt() {
    // Önce form-link'te yeni bir URL var mı kontrol et — varsa parse et
    const link = document.getElementById('form-link').value.trim();
    if (link) {
        const sonuc = urlAnaliz(link);
        if (sonuc) {
            document.getElementById('form-pdfurl').value = sonuc.pdfURL;
            document.getElementById('form-htmlurl').value = sonuc.htmlURL;
            document.getElementById('form-mevzuatno').value = sonuc.mevzuatNo;
            if (sonuc.anahtar && !document.getElementById('form-anahtar').value) {
                document.getElementById('form-anahtar').value = sonuc.anahtar;
            }
        }
    }

    const pdfURL = document.getElementById('form-pdfurl').value.trim();
    const htmlURL = document.getElementById('form-htmlurl').value.trim();
    const mevzuatNo = document.getElementById('form-mevzuatno').value.trim();
    const tur = document.getElementById('form-tur').value;

    if (!pdfURL && !htmlURL) {
        toastGoster('Önce bir mevzuat linki yapıştırın', true);
        return;
    }

    const sonucEl = document.getElementById('test-sonuc');
    sonucEl.className = 'test-sonuc basarili';
    sonucEl.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Bağlantı doğrulanıyor, lütfen bekleyin...';

    try {
        const res = await AUTH.apiFetch('/api/mevzuat-takip/test-url', {
            method: 'POST',
            body: JSON.stringify({ pdfURL, htmlURL, mevzuatNo, tur, tertip: '5' })
        });
        const data = await res.json();

        if (data.basarili) {
            sonucEl.className = 'test-sonuc basarili';
            sonucEl.innerHTML = `
                <i class="fa-solid fa-check-circle"></i>
                <strong>✓ Bağlantı doğrulandı!</strong> PDF indirildi: ${data.detay.boyutKB} KB, ${data.detay.indirmeSuresiMs}ms
                <br><small style="opacity:0.8;">Yöntem: ${data.detay.yontem}</small>
            `;
        } else {
            sonucEl.className = 'test-sonuc basarisiz';
            sonucEl.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> ${_esc(data.detay || data.hata)}`;
        }
    } catch (err) {
        sonucEl.className = 'test-sonuc basarisiz';
        sonucEl.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> Test başarısız: ${_esc(err.message)}`;
    }
}

// ─── FORMU KAYDET ───────────────────────────────────────────────────────────
async function formKaydet() {
    const id = document.getElementById('form-id').value;
    const isUpdate = !!id;

    // Yeni link yapıştırılmışsa, payload'a ondan parse et
    const link = document.getElementById('form-link').value.trim();
    if (link) {
        const sonuc = urlAnaliz(link);
        if (sonuc.gecerli) {
            document.getElementById('form-pdfurl').value = sonuc.pdfURL;
            document.getElementById('form-htmlurl').value = sonuc.htmlURL;
            document.getElementById('form-mevzuatno').value = sonuc.mevzuatNo;
            if (sonuc.anahtar && !isUpdate) {
                document.getElementById('form-anahtar').value = sonuc.anahtar;
            }
        }
    }

    const payload = {
        anahtar:   document.getElementById('form-anahtar').value.trim(),
        ad:        document.getElementById('form-ad').value.trim(),
        kategori:  document.getElementById('form-kategori').value,
        aciklama:  document.getElementById('form-aciklama').value.trim(),
        pdfURL:    document.getElementById('form-pdfurl').value.trim() || null,
        htmlURL:   document.getElementById('form-htmlurl').value.trim() || null,
        mevzuatNo: document.getElementById('form-mevzuatno').value.trim(),
        tur:       document.getElementById('form-tur').value,
        tertip:    '5',
    };

    // Validation
    if (!payload.ad) {
        toastGoster('Mevzuat adı zorunludur', true);
        return;
    }
    if (!payload.pdfURL && !payload.htmlURL) {
        toastGoster('Mevzuat linki gerekli', true);
        return;
    }

    // Anahtar yoksa adından üret (slugify)
    if (!payload.anahtar) {
        payload.anahtar = payload.ad
            .toLowerCase()
            .replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i')
            .replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u')
            .replace(/[^a-z0-9]+/g, '_')
            .replace(/^_+|_+$/g, '')
            .slice(0, 50);
    }

    try {
        const url = isUpdate ? `/api/mevzuat-takip/guncelle/${id}` : '/api/mevzuat-takip/ekle';
        const method = isUpdate ? 'PUT' : 'POST';

        const res = await AUTH.apiFetch(url, {
            method,
            body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.basarili) {
            toastGoster(isUpdate ? 'Mevzuat güncellendi' : 'Mevzuat eklendi');
            formModalKapat();
            await verileriYukle();
        } else {
            toastGoster(data.hata || 'İşlem başarısız', true);
        }
    } catch (err) {
        toastGoster('Hata: ' + err.message, true);
    }
}

// ─── VERSİYON GEÇMİŞİ MODALI ────────────────────────────────────────────────
async function gecmisAc(anahtar, ad) {
    document.getElementById('gecmis-mevzuat-adi').textContent = ad;
    document.getElementById('gecmis-modal').classList.add('acik');
    document.getElementById('gecmis-icerik').innerHTML =
        '<div class="durum-mesaji"><i class="fa-solid fa-spinner fa-spin"></i>Yükleniyor...</div>';

    try {
        const res = await AUTH.apiFetch(`/api/mevzuat-takip/versiyonlar/${anahtar}`);
        const data = await res.json();

        if (!data.basarili || data.sayi === 0) {
            document.getElementById('gecmis-icerik').innerHTML =
                '<div class="durum-mesaji"><i class="fa-solid fa-inbox"></i>Henüz versiyon kaydı yok</div>';
            return;
        }

        const html = data.veri.map((v, idx) => {
            const tarih = new Date(v.olusturmaTarihi).toLocaleString('tr-TR');
            const boyut = (v.boyutByte / 1024).toFixed(2);
            const durumRenk = {
                'yeni': '#16a34a',
                'onaylandi': '#16a34a',
                'onay-bekliyor': '#f59e0b',
                'reddedildi': '#dc2626',
            }[v.durum] || '#64748b';

            return `
                <div style="border-left: 3px solid ${durumRenk}; padding: 12px 16px; margin-bottom: 12px; background: #fafafa; border-radius: 0 9px 9px 0;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                        <div>
                            <strong>v${data.sayi - idx}</strong>
                            <span style="margin-left:8px; padding:2px 8px; background:${durumRenk}; color:#fff; border-radius:4px; font-size:11px;">${v.durum}</span>
                        </div>
                        <div style="font-size:12px; color:#64748b;">${tarih}</div>
                    </div>
                    <div style="font-size:12px; color:#64748b; font-family:monospace;">
                        Hash: ${v.hash.substring(0, 24)}... • Boyut: ${boyut} KB
                    </div>
                    ${v.dosyaYolu ? `<a href="/api/mevzuat-takip/pdf/${v._id}" target="_blank" style="display:inline-block; margin-top:8px; font-size:12px; color:#2563eb;"><i class="fa-solid fa-file-pdf"></i> PDF'i Görüntüle</a>` : ''}
                </div>
            `;
        }).join('');

        document.getElementById('gecmis-icerik').innerHTML = html;
    } catch (err) {
        document.getElementById('gecmis-icerik').innerHTML =
            `<div class="durum-mesaji" style="color:#dc2626;"><i class="fa-solid fa-circle-exclamation"></i>Hata: ${_esc(err.message)}</div>`;
    }
}

function gecmisKapat() {
    document.getElementById('gecmis-modal').classList.remove('acik');
}

