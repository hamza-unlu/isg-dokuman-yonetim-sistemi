<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raporlar - İSG Doküman Yönetim Sistemi</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ==========================================
           RAPORLAR SAYFASI — ÖZEL STİLLER
           ========================================== */

        /* Genel Özet Kartları */
        .rapor-ozet-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .rapor-ozet-kart {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            border: 1px solid #e2e8f0;
            transition: all 0.25s;
        }
        .rapor-ozet-kart:hover {
            box-shadow: 0 6px 20px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }
        .rapor-ozet-ikon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: white;
            flex-shrink: 0;
        }
        .rapor-ozet-ikon.mavi    { background: linear-gradient(135deg, #1d4ed8, #3b82f6); }
        .rapor-ozet-ikon.yesil   { background: linear-gradient(135deg, #059669, #10b981); }
        .rapor-ozet-ikon.kirmizi { background: linear-gradient(135deg, #dc2626, #ef4444); }
        .rapor-ozet-ikon.mor     { background: linear-gradient(135deg, #7c3aed, #8b5cf6); }
        .rapor-ozet-bilgi h4 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #1e293b;
            margin: 0 0 2px 0;
            line-height: 1;
        }
        .rapor-ozet-bilgi span {
            font-size: 0.78rem;
            color: #64748b;
            font-weight: 500;
        }

        /* Firma Rapor Kartları */
        .rapor-firma-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }
        .rapor-firma-kart {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 14px rgba(0,0,0,0.06);
            border: 1.5px solid #e2e8f0;
            overflow: hidden;
            transition: all 0.3s;
            cursor: pointer;
        }
        .rapor-firma-kart:hover {
            border-color: #93c5fd;
            box-shadow: 0 8px 30px rgba(37,99,235,0.12);
            transform: translateY(-3px);
        }

        /* Kart Üst */
        .rapor-kart-ust {
            padding: 18px 20px 14px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            border-bottom: 1px solid #f1f5f9;
        }
        .rapor-firma-ikon {
            width: 44px; height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.15rem; color: white; flex-shrink: 0;
        }
        .rapor-firma-bilgi { flex: 1; min-width: 0; }
        .rapor-firma-bilgi h4 {
            font-size: 0.95rem; font-weight: 700; color: #1e293b;
            margin: 0 0 6px 0;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .rapor-firma-etiketler {
            display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
        }
        .rapor-etiket {
            font-size: 0.68rem; font-weight: 700;
            padding: 2px 8px; border-radius: 10px;
            display: inline-flex; align-items: center; gap: 3px;
        }
        .rapor-etiket.sinif-cok-tehlikeli { background: #fee2e2; color: #b91c1c; }
        .rapor-etiket.sinif-tehlikeli     { background: #fff7ed; color: #c2410c; }
        .rapor-etiket.sinif-az-tehlikeli  { background: #f0fdf4; color: #15803d; }
        .rapor-etiket.sinif-belirsiz      { background: #f1f5f9; color: #64748b; }
        .rapor-etiket.personel-etiket     { background: #ede9fe; color: #6d28d9; }
        .rapor-etiket.belge-etiket        { background: #dbeafe; color: #1d4ed8; }

        /* Kart Orta — Grafik */
        .rapor-kart-grafik {
            padding: 20px;
            display: flex; align-items: center; gap: 20px;
        }
        .donut-sarici {
            position: relative; width: 110px; height: 110px; flex-shrink: 0;
        }
        .donut-sarici svg {
            width: 110px; height: 110px;
            transform: rotate(-90deg);
        }
        .donut-sarici .donut-bg {
            fill: none; stroke: #f1f5f9; stroke-width: 10;
        }
        .donut-sarici .donut-dolgu {
            fill: none; stroke-width: 10; stroke-linecap: round;
            transition: stroke-dashoffset 1s ease, stroke 0.5s;
        }
        .donut-yuzde {
            position: absolute; inset: 0;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
        }
        .donut-yuzde-sayi { font-size: 1.5rem; font-weight: 800; color: #1e293b; line-height: 1; }
        .donut-yuzde-yazi { font-size: 0.65rem; color: #94a3b8; font-weight: 600; margin-top: 2px; }

        /* Kart Sağ — İstatistikler */
        .rapor-istatistik-liste {
            flex: 1; display: flex; flex-direction: column; gap: 8px;
        }
        .rapor-istat-satir {
            display: flex; align-items: center; gap: 8px; font-size: 0.8rem;
        }
        .rapor-istat-nokta {
            width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
        }
        .rapor-istat-nokta.tamam { background: #22c55e; }
        .rapor-istat-nokta.eksik { background: #ef4444; }
        .rapor-istat-nokta.uyari { background: #f59e0b; }
        .rapor-istat-etiket { flex: 1; color: #64748b; font-weight: 500; }
        .rapor-istat-deger  { font-weight: 800; color: #1e293b; }

        /* Kart Alt — Detay */
        .rapor-kart-alt { padding: 0 20px 16px; }
        .rapor-detay-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
        }
        .rapor-detay-kutu {
            background: #f8fafc; border: 1px solid #e2e8f0;
            border-radius: 8px; padding: 8px 10px; text-align: center;
        }
        .rapor-detay-kutu .detay-sayi  { font-size: 1.1rem; font-weight: 800; color: #1e293b; line-height: 1; }
        .rapor-detay-kutu .detay-etiket { font-size: 0.65rem; color: #94a3b8; font-weight: 600; margin-top: 3px; }
        .rapor-detay-kutu.vurgulu { background: linear-gradient(135deg,#eff6ff,#dbeafe); border-color: #93c5fd; }
        .rapor-detay-kutu.vurgulu .detay-sayi   { color: #1d4ed8; }
        .rapor-detay-kutu.vurgulu .detay-etiket { color: #3b82f6; }

        /* Kritik Doküman Tablosu */
        .rapor-tablo-sarici {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            margin-bottom: 24px;
        }
        .rapor-tablo-baslik {
            padding: 16px 22px;
            display: flex; align-items: center; gap: 10px;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
        }
        .rapor-tablo-baslik h3 {
            flex: 1; font-size: 0.95rem; color: #1e293b; margin: 0;
            display: flex; align-items: center; gap: 8px;
        }
        .kritik-sayac {
            background: linear-gradient(135deg, #dc2626, #ef4444);
            color: white; font-size: 0.72rem; font-weight: 800;
            padding: 3px 10px; border-radius: 20px;
        }
        .rapor-kritik-tablo {
            width: 100%; border-collapse: collapse; font-size: 0.82rem;
        }
        .rapor-kritik-tablo thead th {
            background: #0f172a; color: #94a3b8;
            padding: 10px 16px; text-align: left;
            font-size: 0.7rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.06em;
        }
        .rapor-kritik-tablo tbody tr {
            border-bottom: 1px solid #f1f5f9; transition: background 0.15s;
        }
        .rapor-kritik-tablo tbody tr:hover { background: #f8fafc; }
        .rapor-kritik-tablo tbody td { padding: 10px 16px; color: #334155; }
        .rapor-kalan-etiket {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 3px 10px; border-radius: 20px;
            font-size: 0.72rem; font-weight: 700;
        }
        .rapor-kalan-etiket.kritik { background: #fee2e2; color: #dc2626; }
        .rapor-kalan-etiket.uyari  { background: #fef3c7; color: #d97706; }

        /* Bölüm Başlıkları */
        .rapor-bolum-baslik {
            display: flex; align-items: center; gap: 14px; margin-bottom: 16px;
        }
        .rapor-bolum-baslik h3 {
            font-size: 1rem; color: #1e293b; margin: 0;
            display: flex; align-items: center; gap: 8px; white-space: nowrap;
        }
        .rapor-bolum-baslik .bolum-cizgi { flex: 1; height: 1px; background: #e2e8f0; }

        /* Boş Durum */
        .rapor-bos { text-align: center; padding: 60px 20px; color: #94a3b8; }
        .rapor-bos i { font-size: 3rem; margin-bottom: 14px; display: block; color: #cbd5e1; }
        .rapor-bos p { font-size: 0.88rem; margin: 0; }
        .rapor-bos a { color: #2563eb; font-weight: 600; text-decoration: none; }
        .rapor-bos a:hover { text-decoration: underline; }
        .rapor-tablo-bos { text-align: center; padding: 30px 20px; color: #94a3b8; }

        /* Arama */
        .rapor-arama-kutu {
            display: flex; align-items: center; gap: 8px;
            background: #f8fafc; border: 1.5px solid #e2e8f0;
            border-radius: 10px; padding: 8px 14px; transition: border-color 0.2s;
        }
        .rapor-arama-kutu:focus-within { border-color: #3b82f6; }
        .rapor-arama-kutu i { color: #94a3b8; font-size: 0.9rem; }
        .rapor-arama-kutu input {
            border: none; outline: none; background: transparent;
            font-size: 0.85rem; color: #1e293b; width: 200px;
        }

        @media (max-width: 768px) {
            .rapor-firma-grid  { grid-template-columns: 1fr; }
            .rapor-ozet-grid   { grid-template-columns: repeat(2, 1fr); }
            .rapor-kart-grafik { flex-direction: column; align-items: center; }
        }
    </style>
</head>
<body>

<div class="panel-kapsayici">
