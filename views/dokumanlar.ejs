        .klasor-bos i { font-size:2rem; margin-bottom:8px; display:block; color:#cbd5e1; }
        .klasor-bos p { font-size:0.82rem; }
        .modal-onizleme-arka { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.82); z-index:9999; align-items:center; justify-content:center; }
        .modal-onizleme-arka.acik { display:flex; }
        .modal-onizleme-kutu { background:#1e293b; border-radius:14px; width:92vw; max-width:960px; max-height:92vh; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.6); }
        .modal-onizleme-ust { display:flex; align-items:center; gap:12px; padding:13px 18px; background:#0f172a; flex-shrink:0; }
        .modal-onizleme-ust i { color:#94a3b8; font-size:1.1rem; }
        .modal-onizleme-ust span { flex:1; color:#e2e8f0; font-size:0.88rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
