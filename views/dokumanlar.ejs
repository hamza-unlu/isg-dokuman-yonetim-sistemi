        .modal-onizleme-ust .btn-onizleme-kapat { background:rgba(239,68,68,0.2); border:none; color:#fca5a5; padding:5px 13px; border-radius:7px; cursor:pointer; font-size:0.8rem; display:flex; align-items:center; gap:5px; }
