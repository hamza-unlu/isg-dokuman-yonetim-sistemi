        .dosya-duzenle-form label { font-size:10px; font-weight:700; color:#64748b; text-transform:uppercase; }
        .dosya-duzenle-form input[type="date"],.dosya-duzenle-form input[type="text"] { padding:6px 10px; border:1px solid #bbf7d0; border-radius:6px; font-size:12px; color:#1e293b; background:white; outline:none; width:100%; box-sizing:border-box; }
