        .klasor-dosya-satir .dosya-tip-ikon.img-ikon { color:#8b5cf6; }
        .klasor-dosya-satir .dosya-tip-ikon.word-ikon { color:#2563eb; }
        .klasor-dosya-satir .dosya-tip-ikon.excel-ikon { color:#16a34a; }
        .klasor-dosya-satir .dosya-tip-ikon.diger-ikon { color:#64748b; }
        .klasor-dosya-bilgi { flex:1; min-width:0; }
