                    <thead><tr><th>#</th><th>Personel</th><th>Eğitim Tarihi</th><th>Geçerlilik Tarihi</th><th>Durum</th><th>İşlem</th></tr></thead>
                    <tbody id="ilkyardim-modal-tablo-body"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ORTAM ÖLÇÜMLERİ MODAL -->
<div class="modal-olcum-arka" id="olcum-modal" onclick="if(event.target.id==='olcum-modal') olcumModalKapat()">
    <div class="modal-olcum-kutu">
        <div class="modal-olcum-ust">
            <div class="olcum-ust-ikon"><i class="fa-solid fa-chart-line"></i></div>
            <h3 id="olcum-modal-baslik">İş Ekipmanları Ölçüm Durumu</h3>
            <button class="modal-olcum-kapat" onclick="olcumModalKapat()"><i class="fa-solid fa-xmark"></i> Kapat</button>
        </div>
        <div class="modal-olcum-toolbar">
            <div class="olcum-ozet-bar">
                <span class="muayene-ozet-chip toplam" id="olcum-chip-toplam">Toplam: 0</span>
                <span class="muayene-ozet-chip gecerli" id="olcum-chip-gecerli">✓ Geçerli: 0</span>
                <span class="muayene-ozet-chip uyari" id="olcum-chip-uyari">⚠ Uyarı: 0</span>
                <span class="muayene-ozet-chip kritik" id="olcum-chip-kritik">✗ Kritik: 0</span>
            </div>
            <button class="btn-olcum-png" onclick="olcumPNGIndir()"><i class="fa-solid fa-image"></i> PNG İndir</button>
            <button class="btn-olcum-pdf" onclick="olcumPDFIndir()"><i class="fa-solid fa-file-pdf"></i> PDF İndir</button>
        </div>
        <div class="modal-olcum-icerik">
            <div class="olcum-tablo-sarici" id="olcum-tablo-sarici">
                <div class="olcum-modal-bos" id="olcum-modal-bos-mesaj">
                    <i class="fa-solid fa-chart-line"></i>
                    <p>Henüz kayıtlı ekipman ölçümü bulunmuyor.</p>
                </div>
                <table class="olcum-modal-tablo" id="olcum-modal-tablo" style="display:none;">
                 <thead>
                   <tr>
                     <th>#</th><th>Ekipman Adı</th><th>Seri No</th><th>Rapor No</th>
                     <th>Kontrol Firması</th><th>Rapor Tarihi</th><th>Periyot</th><th>Geçerlilik</th><th>Durum</th><th>İşlem</th>
                  </tr>
                 </thead>
                 <tbody id="olcum-modal-tablo-body"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ═══ UZMAN / HEKİM / DSP MODAL ═══ -->
<div class="modal" id="uzman-modal" style="display:none;">
    <div class="modal-icerik" style="max-width:760px;">
        <div class="modal-baslik">
            <h3 id="uzman-modal-baslik">Uzman / Hekim / DSP Durumu</h3>
            <button class="modal-kapat" onclick="const m=document.getElementById('uzman-modal'); m.style.display='none'; m.classList.remove('acik');">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-govde">
            <table class="uzman-tablo">
                <thead>
                    <tr>
                        <th style="width:30%;">Rol</th>
                        <th style="width:30%;">Ad Soyad</th>
                        <th style="width:25%;">Atama Tarihi</th>
                        <th style="width:15%;"></th>
                    </tr>
                </thead>
                <tbody id="uzman-modal-tbody"></tbody>
            </table>
            <p style="font-size:12px;color:#6b7280;margin-top:12px;">
                <i class="fa-solid fa-circle-info"></i>
                Atama tarihi opsiyoneldir, boş bırakılabilir.
            </p>
        </div>
    </div>
</div>

<!-- ÖNİZLEME MODAL -->
<div class="modal-onizleme-arka" id="onizleme-modal" onclick="if(event.target.id==='onizleme-modal') onizlemeKapat()">
    <div class="modal-onizleme-kutu">
        <div class="modal-onizleme-ust">
            <i class="fa-solid fa-file" id="onizleme-tip-ikon"></i>
            <span id="onizleme-dosya-adi">—</span>
            <button class="btn-onizleme-indir" id="onizleme-indir-btn"><i class="fa-solid fa-download"></i> İndir</button>
            <button class="btn-onizleme-kapat" onclick="onizlemeKapat()"><i class="fa-solid fa-xmark"></i> Kapat</button>
        </div>
        <div class="modal-onizleme-icerik" id="onizleme-icerik"></div>
    </div>
</div>


