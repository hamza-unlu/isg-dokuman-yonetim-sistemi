.uzman-tarih-input {
    margin-top: 4px;
    font-size: 12px;
    padding: 4px 6px;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #d1d5db;
    border-radius: 4px;
}
.btn-uzman-kaydet {
    width: 100%;
    padding: 8px 12px;
    background: #16a34a;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    font-weight: 500;
    font-size: 13px;
}
.btn-uzman-kaydet:hover { background: #15803d; }

.btn-uzman-goruntule {
    width: 100%;
    padding: 7px 10px;
    background: linear-gradient(135deg,#fff1f2,#ffe4e6);
    border: 1.5px solid #1d4ed8;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 7px;
    transition: all 0.2s;
    font-size: 10px;
    font-weight: 700;
    color: #1d4ed8;
    margin-top: 3px;
}
.btn-uzman-goruntule:hover {
    background: linear-gradient(135deg,#ffe4e6,#fecaca);
    border-color: #1d4ed8;
}
.uzman-btn-sayi {
    margin-left: auto;
    background: #1d4ed8;
    color: white;
    font-size: 9px;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 10px;
    min-width: 18px;
    text-align: center;
}
.btn-uzman-goruntule:hover { background: #fee2e2; }
.uzman-btn-sayi {
    margin-left: auto;
    background: #1d4ed8;
    color: white;
    border-radius: 9999px;
    padding: 2px 9px;
    font-size: 12px;
    font-weight: 600;
    min-width: 24px;
    text-align: center;
}

.uzman-tablo { width: 100%; border-collapse: collapse; }
.uzman-tablo th, .uzman-tablo td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
    font-size: 13px;
}
.uzman-tablo th { background: #f9fafb; color: #374151; font-weight: 600; }
.uzman-tablo input[type="date"] {
    padding: 4px 6px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 12px;
}
.uzman-tablo .bos-kayit { color: #9ca3af; font-style: italic; }
.uzman-tablo .btn-sil-mini {
    background: #fee2e2;
    color: #dc2626;
    border: none;
    padding: 6px 10px;
    border-radius: 4px;
    cursor: pointer;
}
.uzman-tablo .btn-sil-mini:hover:not(:disabled) { background: #fecaca; }
.uzman-tablo .btn-sil-mini:disabled { opacity: 0.3; cursor: not-allowed; }
.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 9998;
    align-items: center;
    justify-content: center;
}
.modal.acik {
