<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dokümanlar - İSG Doküman Yönetim Sistemi</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .firma-klasor-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:18px; margin-bottom:10px; }
        .firma-klasor-karti { background:#fff; border-radius:14px; box-shadow:0 4px 15px rgba(0,0,0,0.08); padding:22px 20px; cursor:pointer; transition:all 0.25s; border:2px solid transparent; display:flex; flex-direction:column; gap:10px; }
        .firma-klasor-karti:hover { border-color:#2563eb; transform:translateY(-3px); box-shadow:0 8px 25px rgba(37,99,235,0.15); }
        .firma-klasor-ust { display:flex; align-items:center; gap:12px; }
        .klasor-ikon-kutu { width:46px; height:46px; border-radius:12px; background:linear-gradient(135deg,#1d4ed8,#3b82f6); display:flex; align-items:center; justify-content:center; font-size:1.3rem; color:white; flex-shrink:0; }
        .firma-klasor-bilgi h4 { font-size:0.95rem; font-weight:700; color:#1e293b; margin-bottom:3px; }
        .firma-klasor-bilgi span { font-size:0.78rem; color:#64748b; }
        .firma-klasor-alt { display:flex; justify-content:space-between; align-items:center; }
        .firma-dokuman-sayisi { font-size:0.78rem; color:#2563eb; font-weight:700; background:#dbeafe; padding:3px 10px; border-radius:12px; }
        .dokuman-bolum-baslik { display:flex; align-items:center; justify-content:space-between; margin-bottom:15px; }
        .dokuman-bolum-baslik h3 { font-size:1.05rem; color:#1e293b; display:flex; align-items:center; gap:8px; }
        .btn-geri-klasor { background:#f1f5f9; border:1px solid #e2e8f0; color:#475569; padding:7px 16px; border-radius:8px; cursor:pointer; font-size:0.85rem; font-weight:600; display:flex; align-items:center; gap:6px; transition:all 0.2s; }
        .btn-geri-klasor:hover { background:#e2e8f0; }
       
        .isg-sayac-kutu { display:flex; gap:8px; }
        .isg-sayac { padding:4px 11px; border-radius:7px; font-size:0.78rem; font-weight:700; }
        .isg-sayac.tamam { background:#166534; color:#86efac; }
        .isg-sayac.eksik { background:#991b1b; color:#fca5a5; }
        .ilerleme-bar-sarici { background:#f8f9fa; padding:7px 18px; display:flex; align-items:center; gap:12px; border-radius:0 0 10px 10px; margin-bottom:18px; }
        .ilerleme-label { font-size:0.72rem; color:#94a3b8; white-space:nowrap; }
        .ilerleme-cizgi { flex:1; height:7px; background:#334155; border-radius:4px; overflow:hidden; }
        .ilerleme-dolu { height:100%; background:linear-gradient(90deg,#22c55e,#16a34a); border-radius:4px; transition:width 0.5s; }
        .ilerleme-yuzde { font-size:0.78rem; color:#22c55e; font-weight:700; white-space:nowrap; }
        .isg-bolum-baslik { display:flex; align-items:center; gap:7px; font-size:0.72rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.08em; margin:16px 0 9px; }
        .isg-kart-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:11px; margin-bottom:4px; }
        .isg-kart { border-radius:11px; border:2px solid #fca5a5; background:#fff5f5; padding:11px; display:flex; flex-direction:column; gap:7px; transition:border-color 0.3s,background 0.3s; position:relative; }
        .isg-kart.dolu { border-color:#86efac; background:#f0fdf4; }
        .isg-kart-baslik { display:flex; align-items:center; gap:7px; }
        .isg-kart-ikon { width:27px; height:27px; border-radius:7px; display:flex; align-items:center; justify-content:center; font-size:11px; flex-shrink:0; background:#fee2e2; color:#dc2626; transition:background 0.3s,color 0.3s; }
        .isg-kart.dolu .isg-kart-ikon { background:#dcfce7; color:#16a34a; }
        .isg-kart-baslik-metin { font-size:11px; font-weight:700; color:#374151; line-height:1.3; padding-right:36px; }
        .isg-kart-durum { position:absolute; top:9px; right:9px; font-size:9px; font-weight:800; padding:2px 6px; border-radius:20px; background:#fee2e2; color:#dc2626; transition:background 0.3s,color 0.3s; }
        .isg-kart.dolu .isg-kart-durum { background:#dcfce7; color:#16a34a; }
        .isg-kart .mini-label { font-size:9px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:2px; display:block; }
        .isg-kart input[type="text"],.isg-kart input[type="date"],.isg-kart select { width:100%; padding:5px 7px; border:1px solid #e2e8f0; border-radius:6px; font-size:11px; color:#334155; background:white; box-sizing:border-box; }
        .isg-kart input:focus,.isg-kart select:focus { outline:none; border-color:#2563eb; }
        .isg-kart-tarih-cift { display:grid; grid-template-columns:1fr 1fr; gap:5px; }
        .isg-kart-alan { margin-bottom:0; }
        .isg-kart-checkbox { display:flex; align-items:center; gap:7px; padding:5px 7px; background:rgba(255,255,255,0.7); border-radius:6px; border:1px solid #e2e8f0; }
        .isg-kart-checkbox label { font-size:11px; color:#374151; cursor:pointer; font-weight:500; margin:0; }
        .isg-kart-checkbox input[type="checkbox"] { width:13px!important; height:13px!important; accent-color:#2563eb; cursor:pointer; flex-shrink:0; padding:0!important; }
        .ilkyardimci-listesi-kart { display:flex; flex-direction:column; gap:5px; }
        .iy-satir-kart { background:white; border:1px solid #e2e8f0; border-radius:6px; padding:6px; }
        .iy-satir-ust { display:flex; gap:5px; align-items:center; margin-bottom:5px; }
        .iy-satir-ust input { flex:1; }
        .btn-iy-sil { background:#fee2e2; color:#dc2626; border:none; border-radius:5px; width:24px; height:24px; cursor:pointer; font-size:11px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
        .btn-iy-sil:hover { background:#fecaca; }
        .btn-iy-ekle { background:#eff6ff; color:#2563eb; border:1px dashed #93c5fd; border-radius:6px; padding:5px 10px; font-size:11px; font-weight:600; cursor:pointer; width:100%; margin-top:3px; }
        .btn-iy-ekle:hover { background:#dbeafe; }
        .isg-kart-dokuman-alani { border-top:1px dashed #e2e8f0; padding-top:7px; margin-top:2px; }
        #kart-rv .isg-kart-dokuman-alani,#kart-adp .isg-kart-dokuman-alani,#kart-tatbikat .isg-kart-dokuman-alani { border-top:none; padding-top:0; margin-top:0; }
        #kart-rv .isg-kart-tarih-cift,#kart-adp .isg-kart-tarih-cift,#kart-tatbikat .isg-kart-tarih-cift { border-top:1px dashed #e2e8f0; padding-top:7px; margin-top:4px; }
        .isg-kart-dokuman-baslik { font-size:9px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:5px; display:flex; align-items:center; gap:4px; }
        .btn-belge-ekle-label { display:flex; align-items:center; gap:6px; background:linear-gradient(135deg,#eff6ff,#dbeafe); border:1.5px dashed #93c5fd; border-radius:7px; padding:6px 9px; cursor:pointer; font-size:10px; font-weight:700; color:#1d4ed8; margin-bottom:4px; transition:all 0.2s; }
        .btn-belge-ekle-label:hover { background:linear-gradient(135deg,#dbeafe,#bfdbfe); border-color:#2563eb; }
        .btn-klasor-ac { width:100%; padding:7px 10px; background:linear-gradient(135deg,#eff6ff,#dbeafe); border:1.5px solid #93c5fd; border-radius:8px; cursor:pointer; display:flex; align-items:center; gap:7px; transition:all 0.2s; font-size:10px; font-weight:700; color:#1d4ed8; }
        .btn-klasor-ac:hover { background:linear-gradient(135deg,#dbeafe,#bfdbfe); border-color:#2563eb; transform:translateY(-1px); }
        .btn-klasor-ac .klasor-ac-ikon { font-size:14px; color:#f59e0b; }
        .btn-klasor-ac .klasor-ac-sayi { margin-left:auto; background:#2563eb; color:white; font-size:9px; font-weight:800; padding:1px 6px; border-radius:10px; min-width:18px; text-align:center; }
        .muayene-firma-secim { width:100%; padding:5px 7px; border:1px solid #e2e8f0; border-radius:6px; font-size:11px; color:#334155; background:white; box-sizing:border-box; }
        .muayene-firma-secim:focus { outline:none; border-color:#2563eb; }
        .btn-muayene-kaydet { width:100%; padding:6px 10px; background:linear-gradient(135deg,#16a34a,#15803d); color:white; border:none; border-radius:7px; font-size:11px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:5px; transition:opacity 0.2s; margin-top:3px; }
        .btn-muayene-kaydet:hover { opacity:0.85; }
        .muayene-personel-durum { border-radius:7px; padding:5px 9px; font-size:9px; font-weight:700; display:flex; align-items:center; gap:5px; margin-top:3px; }
        .muayene-personel-durum.gecerli { background:#f0fdf4; border:1px solid #86efac; color:#15803d; }
        .muayene-personel-durum.uyari { background:linear-gradient(135deg,#fef3c7,#fde68a); border:1.5px solid #f59e0b; color:#92400e; animation:kurulPulse 2s infinite; }
        .muayene-personel-durum.kritik { background:linear-gradient(135deg,#fee2e2,#fecaca); border:1.5px solid #dc2626; color:#991b1b; animation:kurulPulse 2s infinite; }
        .btn-muayene-goruntule,.btn-egitim-goruntule,.btn-ilkyardim-goruntule,.btn-olcum-goruntule,.btn-temsilci-goruntule { width:100%; padding:7px 10px; background:linear-gradient(135deg,#eff6ff,#dbeafe); border:1.5px solid #93c5fd; border-radius:8px; cursor:pointer; display:flex; align-items:center; gap:7px; transition:all 0.2s; font-size:10px; font-weight:700; color:#1d4ed8; margin-top:3px; }
        .btn-muayene-goruntule:hover,.btn-egitim-goruntule:hover,.btn-ilkyardim-goruntule:hover,.btn-olcum-goruntule:hover,.btn-temsilci-goruntule:hover { background:linear-gradient(135deg,#dbeafe,#bfdbfe); border-color:#2563eb; }
        .muayene-btn-sayi,.egitim-btn-sayi,.ilkyardim-btn-sayi,.olcum-btn-sayi,.temsilci-btn-sayi { margin-left:auto; background:#2563eb; color:white; font-size:9px; font-weight:800; padding:1px 6px; border-radius:10px; min-width:18px; text-align:center; }
        .btn-olcum-goruntule { background:linear-gradient(135deg,#f0fdf4,#dcfce7)!important; border-color:#86efac!important; color:#15803d!important; }
        .btn-olcum-goruntule:hover { background:linear-gradient(135deg,#dcfce7,#bbf7d0)!important; border-color:#22c55e!important; }
        .olcum-btn-sayi { background:#16a34a!important; }
        .btn-ilkyardim-goruntule { background:linear-gradient(135deg,#fff1f2,#ffe4e6)!important; border-color:#fca5a5!important; color:#b91c1c!important; }
        .btn-ilkyardim-goruntule:hover { background:linear-gradient(135deg,#ffe4e6,#fecaca)!important; border-color:#ef4444!important; }
        .ilkyardim-btn-sayi { background:#dc2626!important; }
        .btn-isg-kaydet-panel { width:100%; margin-top:18px; padding:11px; background:linear-gradient(135deg,#16a34a,#15803d); color:white; border:none; border-radius:9px; font-size:0.88rem; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition:opacity 0.2s; }
        .btn-isg-kaydet-panel:hover { opacity:0.92; }
        .kurul-sinif-bilgi { border-radius:7px; padding:6px 9px; font-size:9px; font-weight:700; display:flex; align-items:center; gap:5px; }
        .kurul-sinif-bilgi.cok-tehlikeli { background:linear-gradient(135deg,#fee2e2,#fecaca); border:1px solid #fca5a5; color:#b91c1c; }
        .kurul-sinif-bilgi.tehlikeli { background:linear-gradient(135deg,#fff7ed,#fed7aa); border:1px solid #fb923c; color:#c2410c; }
        .kurul-sinif-bilgi.az-tehlikeli { background:linear-gradient(135deg,#f0fdf4,#dcfce7); border:1px solid #86efac; color:#15803d; }
        .kurul-sinif-bilgi.belirsiz { background:linear-gradient(135deg,#eff6ff,#dbeafe); border:1px solid #93c5fd; color:#1d4ed8; }
        .kurul-plan-satir { display:flex; align-items:center; gap:5px; margin-top:4px; }
        .kurul-plan-satir input[type="date"] { flex:1; min-width:0; }
        .btn-kurul-tamam { background:linear-gradient(135deg,#16a34a,#15803d); color:white; border:none; border-radius:6px; padding:5px 8px; font-size:9px; font-weight:800; cursor:pointer; white-space:nowrap; display:flex; align-items:center; gap:3px; flex-shrink:0; transition:opacity 0.2s; }
        .btn-kurul-tamam:hover { opacity:0.85; }
        .kurul-geri-sayim { border-radius:7px; padding:5px 9px; font-size:9px; font-weight:700; display:none; align-items:center; gap:5px; margin-top:3px; animation:kurulPulse 2s infinite; }
        .kurul-geri-sayim.normal { background:#f0fdf4; border:1px solid #86efac; color:#15803d; animation:none; }
        .kurul-geri-sayim.uyari { background:linear-gradient(135deg,#fef3c7,#fde68a); border:1.5px solid #f59e0b; color:#92400e; }
        .kurul-geri-sayim.kritik { background:linear-gradient(135deg,#fee2e2,#fecaca); border:1.5px solid #dc2626; color:#991b1b; }
        @keyframes kurulPulse { 0%,100%{opacity:1} 50%{opacity:0.75} }
        .kurul-gecmis-liste { display:flex; flex-direction:column; gap:3px; margin-top:4px; max-height:80px; overflow-y:auto; }
        .kurul-gecmis-satir { display:flex; align-items:center; gap:5px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:5px; padding:3px 7px; font-size:9px; color:#64748b; }
        .kurul-gecmis-satir i { color:#22c55e; font-size:8px; }
        .modal-klasor-arka { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:9997; align-items:center; justify-content:center; }
        .modal-klasor-arka.acik { display:flex; }
        .modal-klasor-kutu { background:#fff; border-radius:18px; width:620px; max-width:96vw; max-height:90vh; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 12px 50px rgba(0,0,0,0.25); }
        .modal-klasor-ust { background:#0f172a; padding:16px 20px; display:flex; align-items:center; gap:12px; flex-shrink:0; }
        .modal-klasor-ust .klasor-ust-ikon { color:#f59e0b; font-size:1.3rem; }
        .modal-klasor-ust h3 { flex:1; color:#fff; font-size:0.95rem; margin:0; }
        .modal-klasor-ust .modal-klasor-kapat { background:rgba(239,68,68,0.2); border:none; color:#fca5a5; padding:5px 12px; border-radius:7px; cursor:pointer; font-size:0.8rem; display:flex; align-items:center; gap:5px; }
        .modal-klasor-ust .modal-klasor-kapat:hover { background:rgba(239,68,68,0.35); }
        .modal-klasor-icerik { flex:1; overflow-y:auto; padding:20px; }
        .klasor-dosya-listesi { display:flex; flex-direction:column; gap:10px; margin-bottom:16px; }
        .klasor-dosya-satir { background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px; padding:12px 14px; display:flex; align-items:center; gap:10px; transition:border-color 0.2s; flex-wrap:wrap; }
        .klasor-dosya-satir:hover { border-color:#93c5fd; }
        .klasor-dosya-satir .dosya-tip-ikon { font-size:1.2rem; flex-shrink:0; }
