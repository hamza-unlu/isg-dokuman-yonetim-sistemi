<!-- marked.js CDN (markdown → HTML) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>

<script>
(function() {
    const STORAGE_KEY = 'isg_ai_sohbet_gecmis';
    const ACIK_KEY    = 'isg_ai_sohbet_acik';

    let aiSohbetGecmis = [];
    let aiSohbetMesajGonderiliyor = false;

    // marked ayarları
    if (typeof marked !== 'undefined') {
        marked.setOptions({ breaks: true, gfm: true });
    }

    // ─── Aktif kullanıcı ID'sini al (KVKK güvenliği için) ───
    function aktifKullaniciId() {
        try {
            const k = (typeof AUTH !== 'undefined' && AUTH.kullaniciAl) ? AUTH.kullaniciAl() : null;
            return k && k._id ? String(k._id) : null;
        } catch (e) { return null; }
    }

    function gecmisYukle() {
        try {
            const veri = sessionStorage.getItem(STORAGE_KEY);
            if (!veri) return [];
            const obj = JSON.parse(veri);

            // Eski format (sadece array) ise → temizle, taze başla
            if (Array.isArray(obj)) {
                sessionStorage.removeItem(STORAGE_KEY);
                aiSohbetGecmis = [];
                return [];
            }

            // Yeni format: { kullaniciId, mesajlar }
            const mevcutId = aktifKullaniciId();
            if (!obj || obj.kullaniciId !== mevcutId) {
                // Geçmiş başka kullanıcıya ait → güvenlik için temizle
                sessionStorage.removeItem(STORAGE_KEY);
                aiSohbetGecmis = [];
                return [];
            }
            aiSohbetGecmis = Array.isArray(obj.mesajlar) ? obj.mesajlar : [];
            return aiSohbetGecmis;
        } catch (e) {
            sessionStorage.removeItem(STORAGE_KEY);
            aiSohbetGecmis = [];
            return [];
        }
    }

    function gecmisKaydet() {
        try {
            const paket = {
                kullaniciId: aktifKullaniciId(),
                mesajlar: aiSohbetGecmis,
            };
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify(paket));
        } catch (e) {}
    }

    function gecmisSifirla() {
        aiSohbetGecmis = [];
        sessionStorage.removeItem(STORAGE_KEY);
        sessionStorage.removeItem(ACIK_KEY);
    }

    function gecmisiUIyeYukle() {
        if (aiSohbetGecmis.length === 0) return;
        const karsilama = document.getElementById('ai-karsilama');
        if (karsilama) karsilama.style.display = 'none';
        aiSohbetGecmis.forEach(m => mesajEkleUI(m.rol, m.metin));
    }

    window.aiSohbetAc = function() {
        document.getElementById('ai-sohbet-pencere').classList.add('acik');
        document.getElementById('ai-sohbet-buton').classList.add('gizli');
        localStorage.setItem(ACIK_KEY, '1');
        setTimeout(() => {
            document.getElementById('ai-sohbet-girdi').focus();
            const a = document.getElementById('ai-sohbet-mesajlar');
            a.scrollTop = a.scrollHeight;
        }, 150);
    };

    window.aiSohbetKucult = function() {
        document.getElementById('ai-sohbet-pencere').classList.remove('acik');
        document.getElementById('ai-sohbet-buton').classList.remove('gizli');
        localStorage.removeItem(ACIK_KEY);
    };

    window.aiSohbetKapat = function() {
        document.getElementById('ai-sohbet-pencere').classList.remove('acik');
        document.getElementById('ai-sohbet-buton').classList.remove('gizli');
        gecmisSifirla();
        const alan = document.getElementById('ai-sohbet-mesajlar');
        const karsilama = document.getElementById('ai-karsilama');
        Array.from(alan.children).forEach(c => {
            if (c.id !== 'ai-karsilama') c.remove();
        });
        if (karsilama) karsilama.style.display = '';
    };

    window.aiSohbetOrnekSor = function(buton) {
        // İkon metnini değil, sadece yazıyı al
        const soru = buton.innerText.replace(/^\s*\S+\s*/, '').trim() || buton.textContent.trim();
        document.getElementById('ai-sohbet-girdi').value = soru;
        aiSohbetGonder();
    };

    window.aiSohbetTusBasildi = function(event) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            aiSohbetGonder();
        }
    };

    window.aiSohbetGirdiBoyutAyarla = function(textarea) {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 100) + 'px';
    };

    window.aiSohbetGonder = async function() {
        if (aiSohbetMesajGonderiliyor) return;

        const girdi = document.getElementById('ai-sohbet-girdi');
        const soru = girdi.value.trim();
        if (!soru) return;

        const karsilama = document.getElementById('ai-karsilama');
        if (karsilama) karsilama.style.display = 'none';

        mesajEkleUI('kullanici', soru);
        girdi.value = '';
        girdi.style.height = 'auto';

        yaziyorAc();
        aiSohbetMesajGonderiliyor = true;
        document.getElementById('ai-sohbet-gonder').disabled = true;

        try {
            const yanit = await AUTH.apiFetch('/api/ai/sohbet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ soru, gecmisMesajlar: aiSohbetGecmis }),
            });

            const data = await yanit.json();
            yaziyorKapat();

            if (!yanit.ok || !data.basarili) throw new Error(data.hata || 'Yanıt alınamadı.');

            mesajEkleUI('asistan', data.yanit);

            aiSohbetGecmis.push({ rol: 'kullanici', metin: soru });
            aiSohbetGecmis.push({ rol: 'asistan',   metin: data.yanit });
            if (aiSohbetGecmis.length > 20) aiSohbetGecmis = aiSohbetGecmis.slice(-20);
            gecmisKaydet();

        } catch (err) {
            yaziyorKapat();
            mesajEkleUI('asistan', '⚠️ Üzgünüm, bir hata oluştu: ' + (err.message || 'Bilinmeyen hata'));
        } finally {
            aiSohbetMesajGonderiliyor = false;
            document.getElementById('ai-sohbet-gonder').disabled = false;
            girdi.focus();
        }
    };

    // ─── Mesaj UI'a ekle (markdown render destekli) ──────────────────
    function mesajEkleUI(tip, metin) {
        const alan = document.getElementById('ai-sohbet-mesajlar');

        const mesajDiv = document.createElement('div');
        mesajDiv.className = 'ai-mesaj ' + tip;

        const avatarIkonu = tip === 'kullanici'
            ? '<i class="fa-solid fa-user"></i>'
            : '<i class="fa-solid fa-robot"></i>';

        // Saat damgası
        const simdi = new Date();
        const saat = simdi.getHours().toString().padStart(2,'0') + ':' + simdi.getMinutes().toString().padStart(2,'0');

        let balonIcerik;
        if (tip === 'asistan' && typeof marked !== 'undefined') {
            // Asistan mesajlarında markdown render et
            balonIcerik = marked.parse(metin);
        } else {
            // Kullanıcı mesajlarında XSS koruması
            const div = document.createElement('div');
            div.textContent = metin;
            balonIcerik = div.innerHTML;
        }

        mesajDiv.innerHTML = `
            <div class="ai-mesaj-avatar">${avatarIkonu}</div>
            <div class="ai-mesaj-icerik">
                <div class="ai-mesaj-balon">${balonIcerik}</div>
                <div class="ai-mesaj-zaman">${saat}</div>
            </div>
        `;

        alan.appendChild(mesajDiv);
        setTimeout(() => { alan.scrollTop = alan.scrollHeight; }, 50);
    }

    function yaziyorAc() {
        const y = document.getElementById('ai-yaziyor');
        y.style.display = 'flex';
        const a = document.getElementById('ai-sohbet-mesajlar');
        setTimeout(() => { a.scrollTop = a.scrollHeight; }, 50);
    }
    function yaziyorKapat() {
        document.getElementById('ai-yaziyor').style.display = 'none';
    }

   document.addEventListener('DOMContentLoaded', () => {
    gecmisYukle();
    gecmisiUIyeYukle();
    });
})();
</script>
